# Load: a service writes 1,000 lines a second for LOAD_SECONDS seconds to a
# watch that gathers them a second at a time: the daemon keeps at most 200
# MiB, the runs keep up, and the log of the service turns over.

env HOME=$WORK/home
exec opstruss up -d --yes
exec sleep $LOAD_SECONDS
waitfile emitted
rss 200
# every line that matched made part of a run, unless the daemon says that
# it dropped some
exec sh -c 'n=$(cat emitted); for i in $(seq 60); do s=$(awk "{s+=\$1} END {print s+0}" counted 2> /dev/null); [ "$s" -ge "$n" ] && { echo "kept up"; exit 0; }; sleep 1; done; grep -q dropped .opstruss/logs/default/_daemon.jsonl && echo "dropped and said so" || echo "behind $s of $n"'
stdout '^(kept up|dropped and said so)$'
exec opstruss stop

-- opstruss.yaml --
name: load
units:
  noisy:
    service: lines 1000 "$LOAD_SECONDS"
    pass: [LOAD_SECONDS]
    approval: auto
tasks:
  count:
    run: echo "$N" >> counted
    env: {N: '${{ string(event.count) }}'}
    on:
      watch:
        unit: noisy
        if: event.line.contains('error')
        batch: 1s
