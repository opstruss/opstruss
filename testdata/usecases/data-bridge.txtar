# Data from one tool to the next in the shape each one reads: the servers
# that Ansible reports feed tofu as a typed map, NetBox gets them as JSON
# bodies, Prometheus as a file, the monitoring stack as a .env file, and a
# script as JSON on stdin with its key in a file. NetBox is fakeapi, and a
# unit that loops over an output not known at plan is refused.

env HOME=$WORK/home
env SOPS_AGE_KEY_FILE=$WORK/age/keys.txt
exec chmod 755 scripts/wg-admin.sh
! exec fakeapi -listen 127.0.0.1:18501 api &api&
waitfile api/port
exec opstruss init
agekey age/keys.txt AGE_RECIPIENT
exec sh -c 'printf "creation_rules:\n  - path_regex: secrets.sops.yaml\n    age: %s\n" "$AGE_RECIPIENT" > .sops.yaml'
exec sops encrypt --filename-override secrets.sops.yaml --output secrets.sops.yaml plain.yaml

# dns waits for the servers that hosts reports
exec opstruss plan
stdout '^default/hosts: will run: new$'
stdout '^default/dns: will run: new; plan after default/hosts \(with.vars\)$'

# rollout: Ansible, then tofu with the servers as a map, then NetBox and
# the files
exec opstruss rollout --input netbox=http://127.0.0.1:18501 --yes
stdout '^default/hosts: up: done$'
stdout '^default/dns: up: done$'
exec jq -c '.vars.servers["edge-3"]' .opstruss/state/default/dns/tool/terraform.tfstate
stdout '^{"public_ip":"198.51.100.13","wg_ip":"10.66.0.3","wg_pubkey":"pub-edge-3"}$'
exec opstruss status dns
stdout 'edge-3.example.com'
grep -count=3 '^GET /api/dcim/devices/\?name=edge-[123] auth=Token nb-test-token$' api/requests
grep '^POST /api/dcim/devices/ auth=Token nb-test-token {"custom_fields":{"fqdn":"edge-3.example.com","public_ip":"198.51.100.13","wg_pubkey":"pub-edge-3"},.*"name":"edge-3",' api/requests
grep '^PATCH /api/dcim/devices/11/ .*"fqdn":"edge-1.example.com"' api/requests
grep '^PATCH /api/dcim/devices/12/ .*"fqdn":"edge-2.example.com"' api/requests
cmp out/edge-targets.json want/edge-targets.json
cmp out/edge.env want/edge.env
grep '^PrivateKey = wg-private-key-of-admin$' out/wg-admin.conf
grep -count=3 '^\[Peer\]$' out/wg-admin.conf
! exec grep -r -e wg-private-key -e nb-test-token -e cf-test-token .opstruss

# a unit cannot loop over an output that the run makes
! exec opstruss -C rejected plan
stdout '^default/record: error: if and for_each of record are known when the run starts, but this run changes hosts first; run opstruss up hosts, then this$'

-- plain.yaml --
cloudflare_token: cf-test-token
netbox_token: nb-test-token
admin_wg_private_key: wg-private-key-of-admin
-- api/routes --
GET /api/dcim/devices/ 200 {"count": 1, "results": [{"id": 11}]}
GET /api/dcim/devices/ 200 {"count": 1, "results": [{"id": 12}]}
GET /api/dcim/devices/ 200 {"count": 0, "results": []}
POST /api/dcim/devices/ 201 {"id": 13}
PATCH /api/dcim/devices/* 200 {}
-- ansible/stats.json --
{"servers": {
  "edge-1": {"public_ip": "198.51.100.11", "wg_ip": "10.66.0.1", "wg_pubkey": "pub-edge-1"},
  "edge-2": {"public_ip": "198.51.100.12", "wg_ip": "10.66.0.2", "wg_pubkey": "pub-edge-2"},
  "edge-3": {"public_ip": "198.51.100.13", "wg_ip": "10.66.0.3", "wg_pubkey": "pub-edge-3"}
}}
-- tf/outputs.jq --
{fqdns: ($vars.servers | with_entries(.value = (.key + "." + $vars.zone)))}
-- opstruss.yaml --
# opstruss.yaml
name: edge
description: WireGuard edge servers, from Ansible facts to DNS, CMDB, and configs

uses:
  ansible: ./testplugins/ansible                    # outputs: tool, dari set_stats
  tofu: ./testplugins/tofu                          # state: tool, outputs: tool
  netbox:                                            # http bawaan dengan header tetap
    source: opstruss.http
    with:
      headers:
        Authorization: Token ${{ secrets.netbox_token }}
        Accept: application/json

inputs:
  zone:
    type: string
    default: example.com
  netbox:
    type: string
    default: https://netbox.example.com

secrets:
  cloudflare: {sops: secrets.sops.yaml, field: cloudflare_token}
  netbox_token: {sops: secrets.sops.yaml, field: netbox_token}
  admin_wg_key: {sops: secrets.sops.yaml, field: admin_wg_private_key}

units:
  hosts:                                   # Ansible: WireGuard, lalu set_stats
    uses: ansible
    with:
      playbook: ./ansible/site.yml
      inventory: ./ansible/hosts.yml
  dns:                                     # tofu: satu record per server, loop di HCL
    uses: tofu
    with:
      source: ./tf
      vars:
        zone: ${{ inputs.zone }}
        servers: ${{ units.hosts.outputs.servers }}   # map(object), type tetap
    env:
      CLOUDFLARE_API_TOKEN: ${{ secrets.cloudflare }}

tasks:
  register:
    description: Upsert every edge server in NetBox
    steps:
      - name: Find
        id: find
        for_each: ${{ units.hosts.outputs.servers }}
        netbox:
          url: ${{ inputs.netbox }}/api/dcim/devices/?name=${{ each.key }}
      - name: Create
        for_each: ${{ units.hosts.outputs.servers.filter(k, steps.find[k].outputs.body.count == 0) }}
        netbox:
          method: POST
          url: ${{ inputs.netbox }}/api/dcim/devices/
          status_code: [201]
          body:
            name: ${{ each.value }}
            role: {slug: edge}
            device_type: {slug: vps-small}
            site: {slug: sgp1}
            custom_fields:
              public_ip: ${{ units.hosts.outputs.servers[each.value].public_ip }}
              wg_pubkey: ${{ units.hosts.outputs.servers[each.value].wg_pubkey }}
              fqdn: ${{ units.dns.outputs.fqdns[each.value] }}
      - name: Update
        for_each: ${{ units.hosts.outputs.servers.filter(k, steps.find[k].outputs.body.count > 0) }}
        netbox:
          method: PATCH
          url: ${{ inputs.netbox }}/api/dcim/devices/${{ steps.find[each.value].outputs.body.results[0].id }}/
          body:
            custom_fields:
              public_ip: ${{ units.hosts.outputs.servers[each.value].public_ip }}
              wg_pubkey: ${{ units.hosts.outputs.servers[each.value].wg_pubkey }}
              fqdn: ${{ units.dns.outputs.fqdns[each.value] }}

  publish:
    description: Write monitoring targets, an env file, and the admin WireGuard config
    steps:
      - name: Prometheus targets
        write:
          path: out/edge-targets.json
          format: json
          content: "${{ [{'targets': units.hosts.outputs.servers.map(k, units.dns.outputs.fqdns[k] + ':9100'), 'labels': {'job': 'node'}}] }}"
      - name: Env for the monitoring stack
        write:
          path: out/edge.env
          format: dotenv
          content:
            EDGE_COUNT: ${{ size(units.hosts.outputs.servers) }}
            EDGE_ZONE: ${{ inputs.zone }}
      - name: Admin WireGuard config
        run: [./scripts/wg-admin.sh, out/wg-admin.conf]
        stdin:
          value: ${{ units.hosts.outputs.servers }}
          format: json
        env:
          WG_PRIVATE_KEY_FILE:
            file: ${{ secrets.admin_wg_key }}   # path file sementara 0600, dihapus sesudahnya

  rollout:
    description: Configure servers, publish DNS, register them, and write configs
    steps:
      - task: up
      - task: register
      - task: publish
-- ansible/site.yml --
# ansible/site.yml
- name: WireGuard on edge servers
  hosts: edge
  become: true
  roles:
    - wireguard
  tasks:
    - name: Report server data to OpsTruss
      ansible.builtin.set_stats:
        data:
          servers: "{{ {inventory_hostname: {'public_ip': ansible_default_ipv4.address, 'wg_ip': wg_address, 'wg_pubkey': wg_public_key}} }}"
        aggregate: true                    # dict dari setiap host digabung
-- ansible/hosts.yml --
# ansible/hosts.yml
edge:
  hosts:
    edge-1: {ansible_host: 198.51.100.11, wg_address: 10.66.0.1}
    edge-2: {ansible_host: 198.51.100.12, wg_address: 10.66.0.2}
    edge-3: {ansible_host: 198.51.100.13, wg_address: 10.66.0.3}
-- tf/main.tf --
terraform {
  required_providers {
    cloudflare = { source = "cloudflare/cloudflare", version = "~> 4.40" }
  }
}

variable "zone" { type = string }
variable "servers" {
  type = map(object({ public_ip = string, wg_ip = string, wg_pubkey = string }))
}

data "cloudflare_zone" "this" { name = var.zone }

resource "cloudflare_record" "edge" {
  for_each = var.servers
  zone_id  = data.cloudflare_zone.this.id
  name     = each.key
  type     = "A"
  content  = each.value.public_ip
}

output "fqdns" {
  value = { for name, r in cloudflare_record.edge : name => r.hostname }
}
-- scripts/wg-admin.sh --
#!/usr/bin/env bash
# stdin: map servers (JSON); WG_PRIVATE_KEY_FILE: path kunci admin dari env file OpsTruss.
set -euo pipefail
out="$1"
mkdir -p "$(dirname "$out")"
{
  echo "[Interface]"
  echo "PrivateKey = $(cat "$WG_PRIVATE_KEY_FILE")"
  echo "Address = 10.66.0.100/32"
  jq -r 'to_entries[] | "\n[Peer]\n# \(.key)\nPublicKey = \(.value.wg_pubkey)\nEndpoint = \(.value.public_ip):51820\nAllowedIPs = \(.value.wg_ip)/32"'
} > "$out"
chmod 600 "$out"
-- want/edge-targets.json --
[{"labels":{"job":"node"},"targets":["edge-1.example.com:9100","edge-2.example.com:9100","edge-3.example.com:9100"]}]
-- want/edge.env --
EDGE_COUNT=3
EDGE_ZONE=example.com
-- out/.gitignore --
*
!.gitignore
-- rejected/opstruss.yaml --
name: rejected
uses:
  ansible: ../testplugins/ansible
units:
  hosts:
    uses: ansible
    with:
      playbook: ../ansible/site.yml
  record:                                  # ditolak plan
    for_each: ${{ units.hosts.outputs.servers }}
    run: [./add-record.sh, "${{ each.key }}"]
