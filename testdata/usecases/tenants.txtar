# A SaaS platform learns its tenants from its admin API while it runs.
# One run lists them, checks each with a task whose for_each reads that
# list, keeps the list in kv, and brings one unit per tenant in line with
# task: up in the same run, so a tenant that leaves goes down as planned.
# The admin API is fakeapi; the script that makes a tenant's schema and
# hostname only writes a log.

env HOME=$WORK/home
env ADMIN_TOKEN=admin-test-token
exec chmod 755 scripts/tenant.sh
! exec fakeapi -listen 127.0.0.1:19601 admin &admin&
waitfile admin/port
exec opstruss validate
stdout '^valid$'

# before the first sync no tenant is known, so the unit has no instance
exec opstruss plan
! stdout 'tenant'

# the first sync finds two tenants: each is checked and gets its unit, and
# the report names the one that is not healthy
exec opstruss sync
grep '^up acme pro$' tenants.log
grep '^up globex free$' tenants.log
grep '^GET /tenants/acme/health auth=Bearer admin-test-token$' admin/requests
grep '^GET /tenants/globex/health auth=Bearer admin-test-token$' admin/requests
grep '^POST /reports auth=Bearer admin-test-token \{"changed":\["tenant\[acme\]","tenant\[globex\]"\],"tenants":2,"unhealthy":\["globex"\]\}$' admin/requests
exec opstruss list
stdout '^  default/tenant\[acme\] +run +up$'
stdout '^  default/tenant\[globex\] +run +up$'

# a sync that finds nothing new changes nothing
exec opstruss sync
grep -count=2 '^up ' tenants.log
grep '^POST /reports auth=Bearer admin-test-token \{"changed":\[\],"tenants":2,"unhealthy":\["globex"\]\}$' admin/requests

# acme moves up a plan, globex leaves, and initech joins
cp routes.2 admin/routes
exec opstruss sync
grep '^up acme enterprise$' tenants.log
grep '^up initech free$' tenants.log
grep '^down globex$' tenants.log
grep '^POST /reports auth=Bearer admin-test-token \{"changed":\["tenant\[acme\]","tenant\[globex\]","tenant\[initech\]"\],"tenants":2,"unhealthy":\[\]\}$' admin/requests
exec opstruss plan
stdout '^default/tenant\[acme\]: unchanged$'
stdout '^default/tenant\[initech\]: unchanged$'
! stdout 'globex'

! exec grep -r admin-test-token .opstruss

-- admin/routes --
GET /tenants 200 [{"id": "acme", "plan": "pro"}, {"id": "globex", "plan": "free"}]
GET /tenants/acme/health 200 {"status": "ok"}
GET /tenants/globex/health 503 {"status": "degraded"}
POST /reports 201 {}
-- routes.2 --
GET /tenants 200 [{"id": "acme", "plan": "enterprise"}, {"id": "initech", "plan": "free"}]
GET /tenants/acme/health 200 {"status": "ok"}
GET /tenants/initech/health 200 {"status": "ok"}
POST /reports 201 {}
-- scripts/tenant.sh --
#!/bin/sh
# tenant.sh up|down: the schema and hostname of one tenant. In this test
# it only writes what it would do to tenants.log.
set -eu
if [ "$1" = up ]; then
  echo "up $TENANT $PLAN" >> tenants.log
  echo "host=$TENANT.example.app" >> "$OPSTRUSS_OUTPUT"
else
  echo "down $TENANT" >> tenants.log
fi
-- opstruss.yaml --
name: platform
description: One schema and one hostname for each tenant of the admin API

uses:
  admin:                                   # the admin API through the built-in http
    source: opstruss.http
    with:
      headers:
        Authorization: Bearer ${{ secrets.admin_token }}

secrets:
  admin_token: {env: ADMIN_TOKEN}

units:
  tenant:
    description: The schema and hostname of one tenant
    for_each: ${{ kv('tenants', {}) }}     # written by sync from the admin API
    run: [./scripts/tenant.sh, up]
    down: [./scripts/tenant.sh, down]
    env:
      TENANT: ${{ each.key }}
      PLAN: ${{ each.value.plan }}
    outputs:
      host: {}

tasks:
  check:
    description: Check the health of tenants
    internal: true
    inputs:
      tenants:
        type: array
        items: {type: string}
        required: true
    for_each: ${{ inputs.tenants }}        # in parallel, one instance per tenant
    max_parallel: 4
    outputs:
      healthy:
        value: ${{ steps.health.outputs.status == 200 }}
    steps:
      - name: Health
        id: health
        admin:
          url: http://127.0.0.1:19601/tenants/${{ each.value }}/health
          status_code: [200, 503]

  sync:
    description: Bring the tenants in line with the admin API
    steps:
      - name: List the tenants
        id: list
        admin:
          url: http://127.0.0.1:19601/tenants
      - name: Check them
        id: check
        task: check
        with:
          tenants: ${{ steps.list.outputs.body.map(t, t.id) }}
      - name: Keep them for the unit
        kv:
          key: tenants
          value: "${{ steps.list.outputs.body.transformMapEntry(i, t, {t.id: {'plan': t.plan}}) }}"
      - name: Bring the units in line
        id: up
        task: up
        units: [tenant]
        yes: true                          # a tenant that left goes down
      - name: Report
        admin:
          method: POST
          url: http://127.0.0.1:19601/reports
          status_code: [201]
          body:
            tenants: ${{ size(steps.list.outputs.body) }}
            unhealthy: ${{ steps.check.filter(k, !steps.check[k].outputs.healthy) }}
            changed: ${{ steps.up.units.filter(a, steps.up.units[a].changed) }}
