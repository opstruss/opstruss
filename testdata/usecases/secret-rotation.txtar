# Monthly rotation of a database password with two users: one run writes
# the new password with sops set and commits it, after starts a second run
# that reads the secrets again and rolls the app onto them, and when the
# app is not healthy a rescue reverts the file and a third run rolls back.
# An emergency task rotates everything behind approval. The app is the
# compose test plugin, Slack and the health check are fakeapi, PostgreSQL
# is a fake, and the waits are short. sops in the scripts finds the age key
# where it looks by default, under HOME.

env HOME=$WORK/home
env PATH=$WORK/fakes:$PATH
exec chmod 755 fakes/psql scripts/rotate-db.sh scripts/rotate-cloudflare.sh scripts/rotate-github.sh
! exec fakeapi -listen 127.0.0.1:18701 api &api&
waitfile api/port
exec opstruss init
exec sh -c 'printf "  - path_regex: secrets.sops.yaml\n    age: %s\n" "$(sed -n "s/.*age: //p" .sops.yaml | head -1)" >> .sops.yaml'
mkdir prod
exec sops encrypt --filename-override prod/secrets.sops.yaml --output prod/secrets.sops.yaml plain.yaml
exec git init -q
exec git config user.email ops@example.com
exec git config user.name ops
exec git add opstruss.yaml compose.yaml .sops.yaml prod/secrets.sops.yaml scripts
exec git commit -q -m init

# the app runs on app_a, and the daemon holds the triggers
exec opstruss up -d --stack prod --yes
stdout '^prod/app: up: done$'
grep '^up \S+ app=postgres-client:16 DB_PASSWORD=old-pass DB_USER=app_a$' compose.log

# the first of the month: rotate-db gives app_b a new password and commits
# the file; after starts apply-rotation, which reads the secrets again,
# rolls the app onto app_b, and finds it healthy
exec opstruss rotate-db --stack prod
stdout '^rotate-db: success$'
grep '^psql alter app_b$' calls
exec git log --oneline -1
stdout 'rotate database credentials to app_b$'
waitgrep '^POST /slack {"text":"prod: kredensial database dirotasi"}$' api/requests
grep '^up \S+ app=postgres-client:16 DB_PASSWORD=\S+ DB_USER=app_b$' compose.log
! grep 'DB_PASSWORD=old-pass DB_USER=app_b' compose.log

# the next rotation leaves the app sick: rescue reverts the file and fails
# its run, so rollback brings the app back onto app_b in a run of its own
cp api/routes.sick api/routes
exec opstruss rotate-db --stack prod
grep '^psql alter app_a$' calls
waitgrep '^POST /slack {"text":"prod: aplikasi tidak sehat dengan kredensial baru; dikembalikan"}$' api/requests
waitgrep '(?s)DB_USER=app_b.*DB_USER=app_a.*DB_USER=app_b' compose.log
waitgrep '(?s)(?:GET /healthz.*?){12}' api/requests
exec git log --oneline -1
stdout 'Revert "rotate database credentials to app_a"$'

# an emergency rotates everything behind approval: github fails, the rest
# is committed, and the assert fails the run
! exec opstruss rotate-all --stack prod
stdout '^rotate-all: task rotate-all needs approval; stopped$'
! exec opstruss rotate-all --stack prod --yes
stderr 'sebagian rotasi gagal; lihat record run'
exec git log --oneline -1
stdout 'rotate all credentials$'
! exec grep -r -e old-pass -e admin-pass .opstruss
exec opstruss stop --stack prod

-- plain.yaml --
db_user: app_a
db_password: old-pass
db_admin_url: postgres://admin:admin-pass@db/postgres
slack_webhook: http://127.0.0.1:18701/slack
-- api/routes --
POST /slack 200 ok
GET /healthz 200 ok
-- api/routes.sick --
POST /slack 200 ok
GET /healthz 503 down
GET /healthz 503 down
GET /healthz 503 down
GET /healthz 503 down
GET /healthz 503 down
GET /healthz 503 down
GET /healthz 503 down
GET /healthz 503 down
GET /healthz 503 down
GET /healthz 503 down
GET /healthz 200 ok
-- fakes/psql --
#!/bin/sh
# psql reading SQL on stdin: logs the role that gets a password.
sed -n 's/^ALTER ROLE "\([^"]*\)".*/psql alter \1/p' >> "${0%/*}/../calls"
-- compose.yaml --
services:
  app:
    image: postgres-client:16
    environment:
      DB_USER: ${DB_USER}
      DB_PASSWORD: ${DB_PASSWORD}
-- opstruss.yaml --
# opstruss.yaml
name: app
description: The app, and rotation of its credentials

uses:
  compose: ./testplugins/compose
  slack:
    source: opstruss.http
    with:
      method: POST
      url: ${{ secrets.slack_webhook }}

stacks:
  prod: {}

secrets:
  db_user: {sops: prod/secrets.sops.yaml, field: db_user}
  db_password: {sops: prod/secrets.sops.yaml, field: db_password}
  db_admin_url: {sops: prod/secrets.sops.yaml, field: db_admin_url}
  slack_webhook: {sops: prod/secrets.sops.yaml, field: slack_webhook}

units:
  app:
    uses: compose
    with:
      file: ./compose.yaml
    env:
      DB_USER: ${{ secrets.db_user }}
      DB_PASSWORD: ${{ secrets.db_password }}   # secret berganti: digest HMAC berubah, up menjalankan ulang

tasks:
  rotate-db:
    description: Give the idle database user a new password and point the secrets at it
    on:
      schedule: {cron: "0 3 1 * *", timezone: Asia/Jakarta}
    concurrency: skip
    steps:
      - name: New credentials
        id: new
        run: [./scripts/rotate-db.sh]
        env:
          CURRENT_USER: ${{ secrets.db_user }}
          PGDATABASE: ${{ secrets.db_admin_url }}
        outputs:
          user: {type: string}
      - name: Commit the encrypted file
        run: [git, commit, -m, "rotate database credentials to ${{ steps.new.outputs.user }}", --, prod/secrets.sops.yaml]
      # up tidak di sini: run ini masih memegang value lama, karena secret di-resolve sekali per run

  apply-rotation:
    description: Roll the app onto the rotated credentials and verify it
    internal: true
    on:
      after:                               # setiap trigger boleh list
        - {task: rotate-db, outcome: success}
        - {task: rotate-all, outcome: success}
    steps:
      - name: Roll out
        id: main
        block:
          - task: up
            units: [app]
            yes: true                      # kebijakan project: rotasi terjadwal sudah disetujui
          - name: Healthy
            http:
              url: http://127.0.0.1:18701/healthz
            retry: {attempts: 10, delay: 10ms}
          - slack: {body: {text: "prod: kredensial database dirotasi"}}
        rescue:
          - name: Revert the secrets file
            run: [git, revert, --no-edit, HEAD]
          - slack: {body: {text: "prod: aplikasi tidak sehat dengan kredensial baru; dikembalikan"}}
          - name: Leave the rollback to the next run   # rescue yang berhasil membuat task sukses, dan rollback mengikuti failure
            assert:
              that: false
              msg: kredensial baru tidak sehat; rollback jalan di run berikutnya

  rollback:
    description: Bring the app back onto the previous credentials
    internal: true
    on:
      after: {task: apply-rotation, outcome: failure}
    steps:
      - task: up
        units: [app]
        yes: true
      - name: Healthy again
        http:
          url: http://127.0.0.1:18701/healthz
        retry: {attempts: 10, delay: 10ms}

  rotate-all:
    description: Rotate every credential at once, for example after a provider breach
    approval: ask
    steps:
      - name: Rotate
        id: rotate
        for_each:
          db: ./scripts/rotate-db.sh
          cloudflare: ./scripts/rotate-cloudflare.sh
          github: ./scripts/rotate-github.sh
        run: ["${{ each.value }}"]
        env:
          CURRENT_USER: ${{ secrets.db_user }}
          PGDATABASE: ${{ secrets.db_admin_url }}
        continue_on_error: true
      - name: Commit
        run: [git, commit, -m, "rotate all credentials", --, prod/secrets.sops.yaml]
      - name: Every rotation succeeded
        assert:
          that: size(steps.rotate.filter(k, steps.rotate[k].outcome != 'success')) == 0
          msg: sebagian rotasi gagal; lihat record run
-- scripts/rotate-db.sh --
#!/usr/bin/env bash
# Strategi dua user: user yang tidak dipakai mendapat password baru, lalu menjadi aktif.
# Password lewat stdin psql dan sops, bukan argv, supaya tidak terlihat di daftar proses.
set -euo pipefail
next=app_a
[ "$CURRENT_USER" = app_a ] && next=app_b
password=$(openssl rand -base64 48 | tr -d '/+=\n' | head -c 32)
psql --set=ON_ERROR_STOP=1 --quiet <<SQL
\set pw '$password'
ALTER ROLE "$next" WITH LOGIN PASSWORD :'pw';
SQL
printf '"%s"' "$next" | sops set --value-stdin prod/secrets.sops.yaml '["db_user"]'
printf '"%s"' "$password" | sops set --value-stdin prod/secrets.sops.yaml '["db_password"]'
jq -n --arg user "$next" '{user: $user}' > "$OPSTRUSS_OUTPUT"
-- scripts/rotate-cloudflare.sh --
#!/bin/sh
echo "cloudflare token rotated"
-- scripts/rotate-github.sh --
#!/bin/sh
echo "the admin token expired" >&2
exit 1
