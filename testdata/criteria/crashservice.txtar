# Crash for services: the daemon killed at every point of starting a
# service, and while it runs: after up again, one process of the service
# runs, its record reads, and an interrupted start shows in plan.

[!failpoints] skip 'needs a build with -tags failpoints'
env HOME=$WORK/home
env OPSTRUSS_FAILPOINT_LOG=$WORK/visited

exec opstruss up -d --yes
stdout 'default/web: running'
cp stdout up
exec sh alive up
stdout '^alive 1$'

env OPSTRUSS_FAILPOINT=up-before-pending=kill
exec opstruss stop
! exec opstruss up -d --yes --force
env OPSTRUSS_FAILPOINT=
exec opstruss up -d --yes
stdout 'default/web: running'
cp stdout up
exec sh alive up
stdout '^alive 1$'

env OPSTRUSS_FAILPOINT=up-before-program=kill
exec opstruss stop
! exec opstruss up -d --yes --force
env OPSTRUSS_FAILPOINT=
exec opstruss plan
stdout 'default/web: will run: up of run .* did not finish'
exec opstruss up -d --yes
cp stdout up
exec sh alive up
stdout '^alive 1$'

# killed after the entry and before the gate lets the program run: it
# never runs
env OPSTRUSS_FAILPOINT=service-before-go=kill
exec opstruss stop
exec sh -c 'wc -l < pids'
cp stdout before
! exec opstruss up -d --yes --force
env OPSTRUSS_FAILPOINT=
exec sh -c 'wc -l < pids'
cmp stdout before
exec opstruss up -d --yes
cp stdout up
exec sh alive up
stdout '^alive 1$'

# killed while the service runs: the next daemon stops it before it starts
# it again
env OPSTRUSS_FAILPOINT=up-after-program=kill
exec opstruss stop
! exec opstruss up -d --yes --force
env OPSTRUSS_FAILPOINT=
exec opstruss up -d --yes
cp stdout up
exec sh alive up
stdout '^alive 1$'

env OPSTRUSS_FAILPOINT=up-before-put=kill
exec opstruss stop
! exec opstruss up -d --yes --force
env OPSTRUSS_FAILPOINT=
exec opstruss up -d --yes
cp stdout up
exec sh alive up
stdout '^alive 1$'
exec opstruss state pull web
stdout '"kind": "service"'

exec opstruss stop
exec sh alive
stdout '^alive 0$'
exec sh -c 'sort -u visited'
cmp stdout points

-- points --
proc-list
record-events-write
service-before-go
up-after-program
up-before-pending
up-before-program
up-before-put
-- alive --
# alive [up]: says how many of the pids in pids run; with the output of up,
# it first waits until the service that up started wrote its pid there, as
# up returns once the program started.
if [ -n "$1" ]; then
	pid=$(sed -n 's/.*: running, pid //p' "$1")
	i=0
	until grep -qx "$pid" pids 2> /dev/null; do
		i=$((i + 1))
		[ "$i" -lt 100 ] || { echo "pid $pid is not in pids"; exit 1; }
		sleep 0.1
	done
fi
n=0
for p in $(cat pids); do kill -0 "$p" 2> /dev/null && n=$((n + 1)); done
echo "alive $n"
-- opstruss.yaml --
name: shop
units:
  web:
    service: |
      echo $$ >> pids
      exec sleep 300
    approval: auto
