# Lock: two checkouts that share a plugin backend run up on one unit 500
# times each: its program never overlaps itself, no update is lost, and
# no lock stays behind.

env HOME=$WORK/home
cd one
exec opstruss init --stack default
cd ..
exec sh -c 'cd one && for i in $(seq 500); do opstruss up --force --yes > /dev/null 2>> ../errors || echo failed >> ../errors; done' &
exec sh -c 'cd two && for i in $(seq 500); do opstruss up --force --yes > /dev/null 2>> ../errors || echo failed >> ../errors; done' &
wait
! exists overlap
exec sh -c 'cat errors 2> /dev/null; true'
! stdout .
exec cat count
stdout '^1000$'
cd two
exec opstruss state pull counter
stdout '"n": 1000'
! exists ../store/default/counter/state.lock

-- one/opstruss.yaml --
opstruss: "1.1"
name: shop
backend:
  uses: ../testplugins/fakebackend
  with: {dir: ../store}
units:
  counter:
    run: |
      mkdir ../busy 2> /dev/null || { touch ../overlap; exit 1; }
      n=$(( $(cat ../count 2> /dev/null || echo 0) + 1 ))
      echo "$n" > ../count
      echo "n=$n" >> "$OPSTRUSS_OUTPUT"
      rmdir ../busy
    outputs:
      n: {type: integer}
-- two/opstruss.yaml --
opstruss: "1.1"
name: shop
backend:
  uses: ../testplugins/fakebackend
  with: {dir: ../store}
units:
  counter:
    run: |
      mkdir ../busy 2> /dev/null || { touch ../overlap; exit 1; }
      n=$(( $(cat ../count 2> /dev/null || echo 0) + 1 ))
      echo "$n" > ../count
      echo "n=$n" >> "$OPSTRUSS_OUTPUT"
      rmdir ../busy
    outputs:
      n: {type: integer}
