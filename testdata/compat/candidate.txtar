-- key.txt --
# created: 2026-10-28T10:14:03+08:00
# public key: age1d62m9mh5dz8dmhqtal80c0s6ud7yke5nyuvrfcxu5r6h9nat74ksurxu9d
AGE-SECRET-KEY-1QUW2Y96KKU7GZGYHYWECJZ6TN7KFJSSJR0UXL72LNR0GGRQ5A6ASS0WXXG
-- opstruss.yaml --
# The project that generate.sh runs to write the data of one version: a
# unit with sources and generates, one with a sensitive output, typed
# numbers, a task, and kv, plain and sensitive.
opstruss: "1.0"
name: compat
inputs:
  greeting: {type: string, default: hello}
units:
  build:
    run: [sh, -c, 'mkdir -p out && cp src/app.txt out/app.txt && echo built && echo "size=$(wc -c < out/app.txt | tr -d " ")" >> "$OPSTRUSS_OUTPUT"']
    sources: [src/app.txt]
    generates: [out/app.txt]
    outputs:
      size: {type: integer}
  token:
    run: [sh, -c, 'echo "token=t0ken-$GREETING" >> "$OPSTRUSS_OUTPUT"']
    env: {GREETING: "${{ inputs.greeting }}"}
    outputs:
      token: {type: string, sensitive: true}
  ratio:
    run: [sh, -c, 'echo "{\"ratio\": 2.0, \"count\": 3}" > "$OPSTRUSS_OUTPUT"']
    outputs:
      ratio: {type: number}
      count: {type: integer}
tasks:
  remember:
    steps:
      - kv: {key: last, value: {count: 2, ratio: 0.5}}
      - kv: {key: token, value: "${{ units.token.outputs.token }}"}
  recall:
    steps:
      - log: {msg: "count=${{ kv('last').count }} ratio=${{ units.ratio.outputs.ratio / 4.0 }} size=${{ units.build.outputs.size }}"}
-- out/app.txt --
hello
-- src/app.txt --
hello
