# list, outputs, and runs read the stack without running anything.

env HOME=$WORK/home

exec opstruss list
stdout '^  greet +Say hello +never run$'
stdout '^  default/web +run +absent$'

exec opstruss up --yes
exec opstruss greet
exec opstruss list --json
stdout '"name": "greet"'
stdout '"outcome": "success"'
stdout '"state": "up"'

# outputs are the outputs of the project, from the stored outputs of units
exec opstruss outputs
stdout '^url: https://example.com$'
exec opstruss outputs --json
stdout '"outputs": \{'
stdout '"url": \{'
stdout '"value": "https://example.com"'
stdout '"sensitive": false'

# runs lists the runs, newest first, and shows the events of one again
exec opstruss runs
stdout 'greet +success'
stdout 'up +success'
exec sh -c 'opstruss runs --json | grep -m1 "\"run\":" | cut -d\" -f4 > id'
exec sh -c 'opstruss runs "$(cat id)"'
stdout '^greet \| hello$'
! exec opstruss runs 20200101T000000Z-00000000
stderr 'stack default has no run 20200101T000000Z-00000000'

# OPSTRUSS_LOG=debug writes the diagnostics of the engine to stderr
env OPSTRUSS_LOG=debug
exec opstruss up --yes
stderr '^default/web: took the lock; digest sha256:v1:[0-9a-f]+; unchanged$'

# a task that ran inside a run of another, through task:, needs, or a unit
# that runs it, shows that run in list and in record.json
exec opstruss release
exec opstruss list
stdout '^  greet +Say hello +success in run \S+ via release$'
stdout '^  lint +success in run \S+ via release$'
stdout '^  maybe +failure in run \S+ via release$'
stdout '^  release +success in run \S+$'
stdout '^  stamp-it +success in run \S+ via up$'
exec sh -c 'grep -l release .opstruss/runs/default/*/record.json | xargs cat'
stdout '"tasks": \{\s+"greet": \{\s+"outcome": "success"\s+\},\s+"lint": \{\s+"outcome": "success"\s+\},\s+"maybe": \{\s+"outcome": "failure"'

-- opstruss.yaml --
name: shop
outputs:
  url: ${{ units.web.outputs.url }}
units:
  web:
    run: echo "url=https://example.com" >> "$OPSTRUSS_OUTPUT"
    outputs:
      url: {}
  stamp:
    uses: stamp-it
tasks:
  greet:
    description: Say hello
    run: echo hello
  lint:
    run: echo lint
  maybe:
    inputs:
      fail: {type: boolean}
    run: [test, "${{ inputs.fail }}", "!=", "true"]
    continue_on_error: true
  release:
    needs: [lint]
    steps:
      - task: greet
      - task: maybe
        with: {fail: false}
      - task: maybe
        with: {fail: true}
  stamp-it:
    run: echo stamped
