# moved: carries a record to a new address on up, in stages that a later
# run finishes; the old address keeps a tombstone that old files hit.

env HOME=$WORK/home

exec opstruss up --yes
stdout '^default/web: up: done$'
cp opstruss.yaml old.yaml

# the renamed unit plans from the record it moves from, so it is not new
cp renamed.yaml opstruss.yaml
exec opstruss plan
stdout '^default/site: will move from default/web$'
stdout '^default/site: unchanged$'
! stdout orphan
exec opstruss up --yes
stdout '^default/site: moved from default/web$'
stdout '^default/site: unchanged$'
exec opstruss state pull site
stdout '"url": "https://example.com"'
exec opstruss state pull web
stdout '"moved_to": "default/site"'

# files from before the move hit the tombstone instead of making web again
cp old.yaml opstruss.yaml
! exec opstruss up --yes
stderr '^default/web: this address moved to default/site in run'

# entries chain: what is still at the first address ends at the last
cp renamed.yaml opstruss.yaml
exec opstruss up --yes
cp chained.yaml opstruss.yaml
exec opstruss up --yes
stdout '^default/portal: moved from default/frontend$'
stdout '^default/portal: unchanged$'

# a target that has a record already is refused, and never runs as new
cp both.yaml opstruss.yaml
exec opstruss up --yes
cp clash.yaml opstruss.yaml
! exec opstruss up --yes
stderr '^default/api: moved: default/api has a record already, so default/portal cannot move there$'
exec opstruss state pull portal
stdout '"url": "https://example.com"'

-- opstruss.yaml --
name: shop
units:
  web:
    run: echo "url=https://example.com" >> "$OPSTRUSS_OUTPUT"
    outputs:
      url: {}
-- renamed.yaml --
name: shop
units:
  site:
    run: echo "url=https://example.com" >> "$OPSTRUSS_OUTPUT"
    outputs:
      url: {}
moved:
  - {from: web, to: site}
-- chained.yaml --
name: shop
units:
  portal:
    run: echo "url=https://example.com" >> "$OPSTRUSS_OUTPUT"
    outputs:
      url: {}
moved:
  - {from: web, to: site}
  - {from: site, to: frontend}
  - {from: frontend, to: portal}
-- both.yaml --
name: shop
units:
  portal:
    run: echo "url=https://example.com" >> "$OPSTRUSS_OUTPUT"
    outputs:
      url: {}
  api:
    run: echo api
-- clash.yaml --
name: shop
units:
  api:
    run: echo api
moved:
  - {from: portal, to: api}
