# One declaration of a catalog names its plugins and components: units use
# ops.<package>, and an alias names a package of another declaration, with
# one pin for all of them.
env HOME=$WORK/home
env GREETING=from-env
sourcerepo repo

exec opstruss up --yes
stdout 'default/app \| app from-env'
stdout 'default/greeter \| app from-alias'
stdout 'default/plain \| plain'
stdout 'default/box/page \| box'
stdout 'default/box/said \| said'
stdout 'default/site/page \| site'
stdout 'default/local \| local'
exec opstruss run hello
stdout 'said'
exec sh -c 'test "$(grep -c github.com/opstruss/catalog opstruss.lock)" = 1'
exec opstruss uses
stdout '^NAME +KIND +SOURCE +COMMIT +STATUS$'
stdout '^tool +plugin +ops.tool +[0-9a-f]{7} +present$'
stdout '^ops +catalog +github.com/opstruss/catalog@v1 +[0-9a-f]{7} +present$'
stdout '^only +catalog +./only +- +local$'
exec opstruss uses --json
stdout '"name": "ops",\s+"kind": "catalog"'
exec opstruss uses update tool
stdout '^github.com/opstruss/catalog@v1 +[0-9a-f]{7} +\(unchanged\)$'
exec opstruss plan --locked
! stdout 'will run'

# The path of a package names the same package as the catalog does.
cp path.yaml opstruss.yaml
exec opstruss plan
stdout '^default/plain: unchanged$'

# What a catalog holds is named once, and in two parts.
cp bad.yaml opstruss.yaml
! exec opstruss validate
stderr 'uses.say: toolp.say is a task; an alias names a package of a catalog, and a task is called as toolp.say'
stderr 'uses.twice: tool is an alias itself; name the declaration it names, as ops.tool'
stderr 'uses.nope: ops has no package nope'
stderr 'units.three.uses: names of three parts or more are reserved; to use a task of a package of ops, declare the package in uses:, as tool: ops.tool, and use tool.box'
stderr 'units.tasks.uses: plugin ops.tool has no up, so a unit uses one of its tasks: name it in uses:, as <name>: ops.tool, then uses: <name>.<task>'
stderr 'units.whole.uses: ops is a catalog, as it has no opstruss.plugin.yaml or opstruss.yaml; a unit uses one of its packages, as uses: ops.<package>'
stderr 'tasks.call.steps\[0\].ops.tool: ops is a catalog, whose packages units use; to call a task of ops.tool, name it in uses:, as <name>: ops.tool, and call <name>.<task>'

# A remote directory is named by its source, not by the cache.
cp opstruss.yaml.orig opstruss.yaml
exec git -C repo rm -rq app box plain site tool
exec git -C repo commit -qm empty
exec git -C repo tag -f v1
! exec opstruss uses update
stderr 'units.plain.uses: ops has no package plain; github.com/opstruss/catalog@v1 has no subdirectory with opstruss.plugin.yaml or opstruss.yaml'
! stderr 'cache'

-- opstruss.yaml --
name: collection
uses:
  ops:
    source: github.com/opstruss/catalog@v1
    pass: [GREETING]
  tool: ops.tool
  greeter:
    source: ops.app
    env:
      GREETING: from-alias
  only: ./only
units:
  app:
    uses: ops.app
  greeter:
    uses: greeter
  plain:
    uses: ops.plain
  box:
    uses: ops.box
  site:
    uses: ops.site
  local:
    uses: only.p
tasks:
  hello:
    steps:
      - tool.say: {}
-- opstruss.yaml.orig --
name: collection
uses:
  ops: github.com/opstruss/catalog@v1
units:
  plain:
    uses: ops.plain
-- path.yaml --
name: collection
uses:
  ops:
    source: github.com/opstruss/catalog@v1
    pass: [GREETING]
units:
  plain:
    uses: github.com/opstruss/catalog/plain@v1
-- bad.yaml --
name: collection
uses:
  ops: github.com/opstruss/catalog@v1
  tool: ops.tool
  toolp: github.com/opstruss/catalog/tool@v1
  say: toolp.say
  twice: tool.box
  nope: ops.nope
units:
  three:
    uses: ops.tool.box
  tasks:
    uses: ops.tool
  whole:
    uses: ops
tasks:
  call:
    steps:
      - ops.tool: {}
-- only/p/opstruss.plugin.yaml --
name: p
tasks:
  up:
    run: [echo, local]
-- repo/opstruss.catalog.yaml --
shared: [lib]
-- repo/lib/opstruss.sh --
version=v1
-- repo/app/opstruss.plugin.yaml --
name: app
env: [GREETING]
tasks:
  up:
    run: [sh, -c, 'echo "app $GREETING"']
-- repo/plain/opstruss.plugin.yaml --
name: plain
tasks:
  up:
    run: [echo, plain]
-- repo/tool/opstruss.plugin.yaml --
name: tool
tasks:
  say:
    run: [echo, said]
-- repo/box/opstruss.yaml --
uses:
  tool: ../tool
units:
  page:
    run: [echo, box]
  said:
    uses: tool.say
-- repo/site/opstruss.yaml --
units:
  page:
    run: [echo, site]
