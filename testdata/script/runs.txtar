# Runs that only read, plan, status, and logs, leave nothing in runs/; a
# finished run keeps record.json and events.jsonl, and artifacts/ when a
# program put something there; runs <run> -f follows a run that still
# runs, whose events come out within moments; after still sees a plan; a
# record that cannot be written fails the run and is marked later from
# its last event; a run in the daemon that cannot start ends failed; and
# records and events of a newer OpsTruss are refused.

env HOME=$WORK/home

# plan, status, and logs are not kept
exec opstruss plan
exec opstruss status
exec opstruss logs
exec opstruss runs
! stdout .
exec sh -c 'ls -A .opstruss/runs/default'
! stdout .

# a finished run keeps two files, and artifacts/ only with something in it
exec opstruss up --yes
exec sh -c 'ls -A .opstruss/runs/default/*/'
stdout '^events.jsonl$'
stdout '^record.json$'
! stdout 'lock|artifacts'
exec opstruss keep
exec sh -c 'ls .opstruss/runs/default/*/artifacts'
stdout '^report.txt$'

# a run is named by the start of its random part or of its id, as a short
# commit is in git; a start that two runs share names neither
exec sh -c 'r=$(grep -l "\"task\": \"keep\"" .opstruss/runs/default/*/record.json); r=${r%/record.json}; r=${r##*/}; opstruss runs ${r#*-} && opstruss runs $(printf %.20s $r)'
stdout '"task": "keep"|keep'
! exec opstruss runs 2026
stderr '^opstruss: run 2026 matches [0-9TZ]+-[0-9a-f]+, [0-9TZ]+-[0-9a-f]+; give more of its id$'
! exec opstruss runs abc
stderr 'stack default has no run abc'

# runs <run> -f shows a line of a run that runs before its program ends,
# and ends with the run
exec opstruss slow &slow&
waitgrep '"task": "slow"' '.opstruss/runs/default/*/record.json'
exec sh -c 'r=$(grep -l "\"task\": \"slow\"" .opstruss/runs/default/*/record.json); r=${r%/record.json}; opstruss runs ${r##*/} -f > follow.out' &follow&
waitgrep '^slow \| first$' follow.out
! grep 'second' follow.out
wait follow
grep '^slow \| second$' follow.out
wait slow
! exec opstruss runs -f
stderr '-f follows one run: write opstruss runs <run> -f'

# a plan in the daemon still makes the runs of after plan
exec opstruss up -d --yes
exec opstruss plan
waitfile planned
exec opstruss stop

# a record that cannot be written: the run exits 1, its last event keeps
# what it did, and a later run marks the record from that event once the
# disk takes it
! exec opstruss block --json
stdout '"type":"diagnostic","level":"error","message":"the record of run [0-9a-fTZ-]+ was not written: .*is a directory; the next run of the stack marks it from its events"}$'
stdout '"type":"run","level":"info","task":"block","message":"success","status":"finished","outcome":"success","exit_code":1}$'
exec opstruss keep
stderr '^marking run [0-9a-fTZ-]+, which ended without its record: .*\.record\.tmp: is a directory$'
exec sh -c 'rmdir .opstruss/runs/default/*/.record.tmp'
exec opstruss keep
stderr '^run [0-9a-fTZ-]+ ended without writing its record; it is marked success, as its last event says$'
exec opstruss runs
stdout ' block +success '
! exec opstruss block
stderr '^the record of run [0-9a-fTZ-]+ was not written: '
exec sh -c 'rmdir .opstruss/runs/default/*/.record.tmp'

# a run in the daemon that cannot start ends failed, not running while
# the daemon lives
exec opstruss keep -d
exec sh -c 'rm -rf .opstruss/tmp && touch .opstruss/tmp'
! exec opstruss keep -d
stderr 'tmp: not a directory$'
rm .opstruss/tmp
exec sh -c '! grep -l "\"status\": \"running\"" .opstruss/runs/default/*/record.json'
exec opstruss runs
stdout ' keep +failure '
exec opstruss stop

# records and events of a newer OpsTruss are refused with what to do, and
# a record that is not one names the run to repair or remove
mkdir .opstruss/runs/default/20991231T000000Z-0000ffff
cp newer.json .opstruss/runs/default/20991231T000000Z-0000ffff/record.json
! exec opstruss runs
stderr 'record.json has version 999, written by a newer OpsTruss; this one reads up to 1: upgrade OpsTruss$'
! exec opstruss list
stderr 'upgrade OpsTruss$'
cp current.json .opstruss/runs/default/20991231T000000Z-0000ffff/record.json
cp newer.jsonl .opstruss/runs/default/20991231T000000Z-0000ffff/events.jsonl
! exec opstruss runs 20991231T000000Z-0000ffff
stderr 'event 1 of .*events.jsonl has version 2, written by a newer OpsTruss; this one reads up to 1: upgrade OpsTruss$'
cp broken.json .opstruss/runs/default/20991231T000000Z-0000ffff/record.json
! exec opstruss runs
stderr 'record.json: unexpected end of JSON input; repair it, or remove .*20991231T000000Z-0000ffff to drop that run$'
rm .opstruss/runs/default/20991231T000000Z-0000ffff
exec opstruss runs

-- opstruss.yaml --
name: shop
units:
  web:
    run: echo web
tasks:
  keep:
    run: echo report > "$OPSTRUSS_ARTIFACTS/report.txt"
  slow:
    run: echo first; sleep 2; echo second
  block:
    run: mkdir "$(dirname "$OPSTRUSS_ARTIFACTS")/.record.tmp"
  noted:
    on:
      after:
        - task: plan
    run: touch planned
-- newer.json --
{"version": 999, "run": "20991231T000000Z-0000ffff", "status": "finished"}
-- current.json --
{"version": 1, "run": "20991231T000000Z-0000ffff", "project": "shop", "stack": "default", "command": "task", "task": "keep",
 "host": "h", "pid": 1, "started": "2099-12-31T00:00:00Z", "status": "finished", "outcome": "success", "exit_code": 0}
-- newer.jsonl --
{"v": 2, "seq": 1, "time": "2099-12-31T00:00:00.000Z", "run": "20991231T000000Z-0000ffff", "type": "run", "level": "info", "message": "success"}
-- broken.json --
{"version": 1, "run":
