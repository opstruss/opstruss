# up destroys and forgets nothing while a unit cannot be planned, since
# that unit may be what takes the place of what would go: the instances
# that left for_each and the units that removed: decides wait until every
# unit can be planned, and the other units still run.

env HOME=$WORK/home
exec opstruss up --yes
stdout '^default/a\[y\]: up: done$'

cp waits.yaml opstruss.yaml
! exec opstruss plan
stdout '^default/bad: error: requires: '
stdout '^default/a\[y\]: skipped: waits until every unit can be planned$'
stdout '^default/old: skipped: waits until every unit can be planned$'
stdout '^default/kept: skipped: waits until every unit can be planned$'
! stdout 'will be destroyed|will be forgotten'
! exec opstruss plan --json
stdout '"type":"plan","level":"info","address":"default/a\[y\]",.*"outcome":"skipped","plan":\{.*"reason":"gone"'
stdout '"type":"plan","level":"info","address":"default/old",.*"outcome":"skipped","plan":\{.*"reason":"removed"'

! exec opstruss up --yes
stdout '^default/c: up: done$'
stdout '^default/a\[y\]: skipped: waits until every unit can be planned$'
! exists destroys
exec opstruss state list
stdout 'default/a\[y\]'
stdout 'default/old'
stdout 'default/kept'

# once every unit can be planned, they go
cp fixed.yaml opstruss.yaml
exec opstruss up --yes
stdout '^default/a\[y\]: destroy: done$'
stdout '^default/old: destroy: done$'
stdout '^default/kept: forgotten; a tombstone stays at the address$'
grep '^a\[y\]$' destroys
grep '^old$' destroys

# a plan made at its turn holds them too: one that fails there, after the
# unit that may install the program, and one that its turn never makes, as
# the unit it needs failed
cp turn.yaml opstruss.yaml
! exec opstruss up --yes
stdout '^default/prepare: up: done$'
stderr '^default/replacement: requires: no-such-program-anywhere is not in PATH$'
stdout '^default/c: skipped: waits until every unit can be planned$'
stdout '^default/bad: skipped: waits until every unit can be planned$'
! grep '^c$' destroys
exec opstruss state list
stdout 'default/c\s'
! stdout 'default/bad\s+forgotten'

cp failed.yaml opstruss.yaml
! exec opstruss up --yes
stdout '^default/replacement: skipped: default/prepare is failure$'
stdout '^default/c: skipped: waits until every unit can be planned$'
stdout '^default/bad: skipped: waits until every unit can be planned$'
! grep '^c$' destroys

# an interrupt before their turn leaves them all, also what is forgotten
cp interrupt.yaml opstruss.yaml
! exec opstruss up --yes &up&
waitgrep go started
kill -INT up
wait up
stdout '^default/c: interrupted before its turn$'
stdout '^default/bad: interrupted before its turn$'
exec opstruss state list
! stdout 'default/bad\s+forgotten'

cp done.yaml opstruss.yaml
exec opstruss up --yes
stdout '^default/c: destroy: done$'
stdout '^default/bad: forgotten; a tombstone stays at the address$'
grep '^c$' destroys

-- opstruss.yaml --
name: waits
units:
  a:
    for_each: [x, y]
    run: echo a
    destroy: echo "${OPSTRUSS_ADDRESS#default/}" >> destroys
  old:
    run: echo old
    destroy: echo old >> destroys
  kept:
    run: echo kept
-- waits.yaml --
name: waits
units:
  a:
    for_each: [x]
    run: echo a
    destroy: echo "${OPSTRUSS_ADDRESS#default/}" >> destroys
  bad:
    run: echo bad
    requires: [no-such-program-anywhere]
  c:
    run: echo c
    destroy: echo c >> destroys
removed:
  - {from: old, destroy: true}
  - {from: kept, destroy: false}
-- fixed.yaml --
name: waits
units:
  a:
    for_each: [x]
    run: echo a
    destroy: echo "${OPSTRUSS_ADDRESS#default/}" >> destroys
  bad:
    run: echo bad
  c:
    run: echo c
    destroy: echo c >> destroys
removed:
  - {from: old, destroy: true}
  - {from: kept, destroy: false}
-- turn.yaml --
name: waits
units:
  a:
    for_each: [x]
    run: echo a
    destroy: echo "${OPSTRUSS_ADDRESS#default/}" >> destroys
  prepare:
    run: echo prepare
  replacement:
    needs: [prepare]
    run: echo replacement
    requires: [no-such-program-anywhere]
removed:
  - {from: c, destroy: true}
  - {from: bad, destroy: false}
-- failed.yaml --
name: waits
units:
  a:
    for_each: [x]
    run: echo a
    destroy: echo "${OPSTRUSS_ADDRESS#default/}" >> destroys
  prepare:
    run: exit 3
  replacement:
    needs: [prepare]
    run: echo replacement
    requires: [no-such-program-anywhere]
removed:
  - {from: c, destroy: true}
  - {from: bad, destroy: false}
-- interrupt.yaml --
name: waits
units:
  a:
    for_each: [x]
    run: echo a
    destroy: echo "${OPSTRUSS_ADDRESS#default/}" >> destroys
  prepare:
    run: echo prepare
  replacement:
    needs: [prepare]
    run: echo replacement
  slow:
    run: echo go > started; sleep 30
removed:
  - {from: c, destroy: true}
  - {from: bad, destroy: false}
-- done.yaml --
name: waits
units:
  a:
    for_each: [x]
    run: echo a
    destroy: echo "${OPSTRUSS_ADDRESS#default/}" >> destroys
  prepare:
    run: echo prepare
  replacement:
    needs: [prepare]
    run: echo replacement
  slow:
    run: echo slow
removed:
  - {from: c, destroy: true}
  - {from: bad, destroy: false}
