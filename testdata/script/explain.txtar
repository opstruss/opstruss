# explain prints one stack as read and resolved: include files and stack
# overrides merged, and each project input with where its value came from.

! exec opstruss explain
stderr 'the project has stacks dev, prod; choose one with --stack'

exec opstruss explain --stack prod
stdout '^stack: prod$'
stdout '^  domain:\n    value: example.com\n    from: stack$'
stdout '^  replicas:\n    value: 2\n    from: default$'
stdout '^  backup:$'
stdout '^  listen: 127.0.0.1:7879$'

# the dev stack has no backup unit, and $OPSTRUSS_STACK chooses the stack
env OPSTRUSS_STACK=dev
exec opstruss explain
stdout '^stack: dev$'
! stdout 'backup'
env OPSTRUSS_STACK=

# --input wins over the stack, and env: fills an input that nothing gave
env APP_DEBUG=true
exec opstruss explain --stack dev --input replicas=5 --json
stdout '"replicas": \{\n      "value": 5,\n      "from": "--input"'
stdout '"debug": \{\n      "value": true,\n      "from": "env"'

# locals are computed, and units come in the order of their dependencies
exec opstruss explain --stack prod
stdout '^locals:\n  host: app-prod.example.com$'
stdout '^order:\n  - backup\n  - db\n  - site$'

# names pick units and tasks, with the units they read and the tasks they need
exec opstruss explain --stack prod release
stdout '^  release:$'
stdout '^  notes:$'
! stdout 'site:'
exec opstruss explain --stack prod site
stdout '^order:\n  - db\n  - site$'
! stdout 'backup:'
! exec opstruss explain --stack prod nope
stderr 'the project has no unit or task nope; it has backup, db, notes, release, site'

! exec opstruss explain --stack dev --input replicas=many
stderr '--input replicas: "many" is not an integer'

-- opstruss.yaml --
name: app
include: [tasks/*.yaml]
inputs:
  domain:
    type: string
  replicas:
    type: integer
    default: 2
  debug:
    type: boolean
    env: APP_DEBUG
runtime:
  listen: 127.0.0.1:7878
stacks:
  dev:
    with:
      domain: example.dev
  prod:
    with:
      domain: example.com
    runtime:
      listen: 127.0.0.1:7879
    include: [prod/*.yaml]
locals:
  host: ${{ opstruss.project }}-${{ stack }}.${{ inputs.domain }}
units:
  db:
    run: [./db.sh]
    outputs:
      url: {from: stdout}
  site:
    run: [npm, run, build]
    env:
      DATABASE_URL: ${{ units.db.outputs.url }}
-- tasks/release.yaml --
tasks:
  notes:
    run: [./notes.sh]
  release:
    needs: [notes]
    run: [./release.sh]
-- prod/backup.yaml --
units:
  backup:
    run: [./backup.sh]
