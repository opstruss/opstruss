# opstruss init sets up a project, adding only what is missing:
# opstruss.yaml, whose first line names the schema for editors that init
# writes in .opstruss/, and .opstruss/ in .gitignore. Then it checks every
# stack as validate does and fetches what the project uses, so a fresh
# clone is ready to plan. It makes no key: the first command that needs the
# age key of this machine or the data key of a stack makes it.

env HOME=$WORK/home

# a new project takes its name from the directory
mkdir 'My_App 2'
exec opstruss -C 'My_App 2' init
stdout '^wrote opstruss.yaml$'
stdout '^wrote .gitignore$'
stdout '^next: add units or tasks to opstruss.yaml, then run opstruss plan$'
! stdout 'age|sops'
cmp 'My_App 2/opstruss.yaml' want/opstruss.yaml
cmp 'My_App 2/.gitignore' want/gitignore
exists 'My_App 2/.opstruss/schema.json'
! exists 'My_App 2/.sops.yaml'
! exists home

# init again changes nothing, and --name only names a new project
exec opstruss -C 'My_App 2' init
! stdout 'wrote'
stdout '^next: run opstruss plan$'
cmp 'My_App 2/opstruss.yaml' want/opstruss.yaml
! exec opstruss -C 'My_App 2' init --name other
stderr 'already has opstruss.yaml'

# a name that cannot come from the directory comes from --name
mkdir 123
! exec opstruss -C 123 init
stderr 'cannot make a project name from "123"; give one with --name'
! exists 123/opstruss.yaml
! exec opstruss -C 123 init --name Bad
stderr '--name Bad'
exec opstruss -C 123 init --name ops
grep '^name: ops$' 123/opstruss.yaml

# init leaves .gitignore alone when it already ignores .opstruss, and a
# .gitignore without a final newline gets one
mkdir mine nonl
cp mine.gitignore mine/.gitignore
exec opstruss -C mine init --name mine
! stdout 'wrote .gitignore'
cmp mine/.gitignore mine.gitignore
exec sh -c 'printf dist/ > nonl/.gitignore'
exec opstruss -C nonl init --name nonl
cmp nonl/.gitignore want/nonl.gitignore

# --stack also makes that stack's _meta, without a data key; --json says
# what changed
mkdir stacks
cp stacks.yaml stacks/opstruss.yaml
exec opstruss -C stacks init --stack dev --json
stdout '"wrote": \['
stdout '"dev/_meta"'
stdout '"sources": \[\]'
! stdout 'age'
exec opstruss -C stacks state pull _meta --stack dev
stdout '"project": "stacks"'
! stdout '"key"'
! exists stacks/.opstruss/state/prod/_meta
exec opstruss -C stacks init --stack dev
! stdout 'wrote'
! exec opstruss -C stacks init --stack qa
stderr 'qa'

# in a clone, init writes the schema that the first line names, and says
# what comes next
mkdir clone
cp clone.yaml clone/opstruss.yaml
exec opstruss -C clone init
stdout '^wrote .gitignore$'
stdout '^next: run opstruss plan$'
exists clone/.opstruss/schema.json

# a project with problems gets all of them, as validate gives them, and no
# schema; the output names only what init wrote before it stopped
mkdir broken
cp broken.yaml broken/opstruss.yaml
! exec opstruss -C broken init
stderr '^opstruss.yaml:3:1: unit: unknown key; did you mean units\?$'
stderr '^opstruss.yaml:4:1: task: unknown key'
stdout '^wrote \.gitignore$'
! stdout 'next|opstruss\.yaml'
! exists broken/.opstruss/schema.json


# without git in PATH, a source from git says what is missing, and init
# still names the files it wrote before it stopped
mkdir nogit empty
cp nogit.yaml nogit/opstruss.yaml
exec sh -c 'ln -s "$(command -v opstruss)" empty/opstruss'
env PATH=$WORK/empty
! exec opstruss -C nogit init
stderr 'opstruss\.yaml:3:3: uses\.ops: git is not in PATH, and fetching a source from git needs it$'
! stderr 'executable file not found|git init failed'
stdout '^wrote \.gitignore$'
exists nogit/.gitignore
-- want/opstruss.yaml --
# yaml-language-server: $schema=.opstruss/schema.json
opstruss: "1.0"
name: my_app-2
-- want/gitignore --
.opstruss/
-- mine.gitignore --
node_modules/
/.opstruss
-- want/nonl.gitignore --
dist/
.opstruss/
-- stacks.yaml --
name: stacks
stacks:
  dev: {}
  prod: {}
-- clone.yaml --
# yaml-language-server: $schema=.opstruss/schema.json
opstruss: "1.0"
name: clone
units:
  hello:
    run: echo hello
-- broken.yaml --
# yaml-language-server: $schema=.opstruss/schema.json
name: broken
unit: {}
task: {}
-- nogit.yaml --
name: nogit
uses:
  ops: github.com/opstruss/catalog@v1
