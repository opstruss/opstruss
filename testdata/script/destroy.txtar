# destroy runs the destroy contract of each record, units that depend on others
# first; up destroys the instances that left for_each, and removed:
# decides about units that left the files.

env HOME=$WORK/home
env AWS_PROFILE=dev

exec opstruss up --yes
stdout '^default/app\[eu\]: up: done$'

# protect refuses destroy before anything is destroyed, also the units that
# depend on it
! exec opstruss destroy vault --yes
stderr '^default/vault: protect: true refuses destroy; .*nothing was destroyed$'
exists '.opstruss/state/default/app[eu]/state.json'

# a pass value that differs from the record refuses destroy; --force runs it
env AWS_PROFILE=prod
! exec opstruss destroy --yes --no-deps app
stderr 'pass values differ from those of the record: AWS_PROFILE; destroy --force'
exec opstruss destroy --yes --force --no-deps 'app[eu]'
stdout '^default/app\[eu\] \| destroy id-eu$'
grep '^app\[eu\]$' destroys
env AWS_PROFILE=dev

# an instance that leaves for_each is destroyed at up, after the turns
exec opstruss up --yes
stdout '^default/app\[eu\]: up: done$'
cp opstruss2.yaml opstruss.yaml
exec opstruss plan
stdout '^default/app\[us\]: will be destroyed: its instance is no longer in if or for_each$'
exec opstruss up --yes
stdout '^default/app\[us\]: destroy: done$'
grep '^app\[us\]$' destroys
# the record of that run names the instance it took destroy
exec sh -c 'ls -t .opstruss/runs/default/*/record.json | head -n 1 | xargs cat'
stdout '"app\[us\]": \{\s+"outcome": "success",\s+"changed": true,\s+"plan": "will be destroyed: its instance is no longer in if or for_each"'

# a unit that leaves the files is an orphan until removed: decides
cp opstruss3.yaml opstruss.yaml
exec opstruss up --yes
stderr '^default/cache: orphan: its unit is no longer in the files; add \{from: cache, destroy: true\} to removed: to destroy it, or destroy: false to forget it$'
exists .opstruss/state/default/cache/state.json
cp opstruss4.yaml opstruss.yaml
exec opstruss plan
stdout '^default/cache: will be forgotten without being destroyed: removed: with destroy: false$'
stdout '^default/old: will be destroyed: removed: with destroy: true$'
exec opstruss up --yes
stdout '^default/cache: forgotten; a tombstone stays at the address$'
stdout '^default/old: destroy: done$'
grep '^old$' destroys
! grep cache destroys

# a tombstone keeps an old checkout from making a second unit there
cp opstruss5.yaml opstruss.yaml
! exec opstruss up --yes
stdout '^default/cache: error: this address was forgotten in run'
exec opstruss state rm cache
exec opstruss up --yes
stdout '^default/cache: up: done$'

-- opstruss.yaml --
name: shop
units:
  vault:
    run: echo vault
    destroy: echo vault >> destroys
    protect: true
  app:
    for_each: [eu, us]
    run: [sh, -c, 'echo "id=id-$1" >> "$OPSTRUSS_OUTPUT"', app, "${{ each.key }}"]
    destroy: |
      echo "destroy $(grep -o '"id":"[^"]*"' "$OPSTRUSS_STATE" | cut -d'"' -f4)"
      echo "${OPSTRUSS_ADDRESS#default/}" >> destroys
    outputs:
      id: {}
    pass: [AWS_PROFILE]
    needs: [vault]
  cache:
    run: echo cache
  old:
    run: echo old
    destroy: echo old >> destroys
-- opstruss2.yaml --
name: shop
units:
  vault:
    run: echo vault
    destroy: echo vault >> destroys
    protect: true
  app:
    for_each: [eu]
    run: [sh, -c, 'echo "id=id-$1" >> "$OPSTRUSS_OUTPUT"', app, "${{ each.key }}"]
    destroy: echo "${OPSTRUSS_ADDRESS#default/}" >> destroys
    outputs:
      id: {}
    pass: [AWS_PROFILE]
    needs: [vault]
  cache:
    run: echo cache
  old:
    run: echo old
    destroy: echo old >> destroys
-- opstruss3.yaml --
name: shop
units:
  vault:
    run: echo vault
    protect: true
-- opstruss4.yaml --
name: shop
units:
  vault:
    run: echo vault
    protect: true
removed:
  - {from: cache, destroy: false}
  - {from: old, destroy: true}
  - {from: app, destroy: false}
-- opstruss5.yaml --
name: shop
units:
  vault:
    run: echo vault
    protect: true
  cache:
    run: echo cache
