# A remote catalog hashes each package with the shared paths: a commit
# outside them runs nothing again, while records and cleanup keep pins.
env HOME=$WORK/home
chmod 755 repo/a/up.sh
chmod 755 repo/a/destroy.sh
sourcerepo repo
exec git -C repo config user.name Fixture
exec git -C repo config user.email fixture@example.invalid

exec opstruss up --yes
stdout 'default/a \| up-v1'
stdout 'default/site/page \| page-v1'
stdout 'default/site/shared \| shared-unit'
exec opstruss plan --locked
! stdout 'will run'
cp opstruss.lock before.lock

# A commit outside the packages and the shared paths runs nothing again,
# and the record follows the new pin.
exec sh -c 'echo v2 > repo/README.md'
exec git -C repo commit -qam readme
exec git -C repo tag -f v1
exec opstruss uses update
! cmp opstruss.lock before.lock
exec opstruss plan --locked
stdout '^default/a: unchanged$'
stdout '^default/site/page: unchanged$'
exec opstruss up --yes --locked
! stdout 'up-v'
! stdout 'page-v'
exec sh -c 'opstruss state pull a | grep -qF "$(git -C repo rev-parse HEAD)"'
exec sh -c 'opstruss state pull a | grep -qF "$(grep -o "h1:[A-Za-z0-9+/=]*" opstruss.lock | head -n 1)"'

# A change of a shared path changes every package of the catalog.
exec sh -c 'echo version=v2 > repo/lib/opstruss.sh'
exec git -C repo commit -qam lib
exec git -C repo tag -f v1
exec opstruss uses update
exec opstruss plan --locked
stdout '^default/a: will run: definition changed: plugin$'
stdout '^default/site/page: will run: definition changed: component$'

# A package that comes to need a newer OpsTruss stops update, which keeps
# the pins, so the project runs on them until OpsTruss is upgraded.
cp opstruss.lock before.lock
cp newer.yaml repo/a/opstruss.plugin.yaml
exec git -C repo commit -qam newer
exec git -C repo tag -f v1
! exec opstruss uses update
stderr '^github.com/opstruss/catalog@v1/a/opstruss.plugin.yaml:1:1: opstruss: this file is for OpsTruss 1.99 or newer; this OpsTruss reads files up to 1.0: upgrade OpsTruss$'
! stderr 'cache/git'
! stderr 'unknown key'
cmp opstruss.lock before.lock
exec opstruss plan --locked
stdout '^default/a: will run: definition changed: plugin$'

# A package of the catalog that needs a newer OpsTruss stops only the
# projects that use it.
cp a.yaml repo/a/opstruss.plugin.yaml
mkdir repo/c
cp later.yaml repo/c/opstruss.plugin.yaml
exec git -C repo add c
exec git -C repo commit -qam later
exec git -C repo tag -f v1
exec opstruss uses update
! cmp opstruss.lock before.lock
exec opstruss plan --locked
stdout '^default/a: will run: definition changed: plugin$'

# Cleanup runs the destroy of the pin in the record, fetched again.
cp removed.yaml opstruss.yaml
exec sh -c 'chmod -R u+w "$HOME/.opstruss/cache/git"; rm -rf "$HOME/.opstruss/cache/git"'
exec opstruss up --yes
stdout 'default/a \| destroy-v1'
! stdout 'destroy-v2'

# The relative paths of a package stay in it and the shared paths.
cp full.yaml opstruss.yaml
cp opstruss.lock before.lock
cp other.yaml repo/a/opstruss.plugin.yaml
exec git -C repo commit -qam other
exec git -C repo tag -f v1
! exec opstruss uses update
stderr 'tasks.up.run\[0\]: \.\./b/up.sh leads outside its package and the shared paths of its catalog'
cmp opstruss.lock before.lock
cp upward.yaml repo/site/opstruss.yaml
exec git -C repo commit -qam upward
exec git -C repo tag -f v1
! exec opstruss uses update
stderr 'include\[0\]: \.\./b/units.yaml leads outside its package'
cmp opstruss.lock before.lock

# Without opstruss.catalog.yaml they stay in the repository.
exec git -C repo rm -q opstruss.catalog.yaml
cp outside.yaml repo/a/opstruss.plugin.yaml
cp full-site.yaml repo/site/opstruss.yaml
exec git -C repo commit -qam outside
exec git -C repo tag -f v1
! exec opstruss uses update
stderr 'tasks.up.run\[0\]: \.\./\.\./outside.sh leads outside its repository'
cmp opstruss.lock before.lock

-- opstruss.yaml --
name: catalog
uses:
  a: github.com/opstruss/catalog/a@v1
  ops: github.com/opstruss/catalog@v1
units:
  a:
    uses: a
  site:
    uses: ops.site
-- full.yaml --
name: catalog
uses:
  a: github.com/opstruss/catalog/a@v1
  ops: github.com/opstruss/catalog@v1
units:
  a:
    uses: a
  site:
    uses: ops.site
-- removed.yaml --
name: catalog
removed:
  - {from: a, destroy: true}
  - {from: site, destroy: true}
-- repo/opstruss.catalog.yaml --
shared: [lib]
-- repo/README.md --
v1
-- repo/lib/opstruss.sh --
version=v1
-- repo/lib/units.yaml --
units:
  shared:
    run: [echo, shared-unit]
-- repo/a/opstruss.plugin.yaml --
name: a
tasks:
  up:
    run: [./up.sh]
  destroy:
    run: [./destroy.sh]
-- repo/a/up.sh --
#!/bin/sh
. "$OPSTRUSS_PLUGIN_DIR/../lib/opstruss.sh"
echo "up-$version"
-- repo/a/destroy.sh --
#!/bin/sh
. "$OPSTRUSS_PLUGIN_DIR/../lib/opstruss.sh"
echo "destroy-$version"
-- repo/b/units.yaml --
units:
  other:
    run: [echo, other]
-- repo/site/opstruss.yaml --
include: [../lib/units.yaml]
units:
  page:
    run: [echo, page-v1]
-- full-site.yaml --
include: [../lib/units.yaml]
units:
  page:
    run: [echo, page-v1]
-- upward.yaml --
include: [../b/units.yaml]
units:
  page:
    run: [echo, page-v1]
-- other.yaml --
name: a
tasks:
  up:
    run: [../b/up.sh]
  destroy:
    run: [./destroy.sh]
-- outside.yaml --
name: a
tasks:
  up:
    run: [../../outside.sh]
  destroy:
    run: [./destroy.sh]
-- a.yaml --
name: a
tasks:
  up:
    run: [./up.sh]
  destroy:
    run: [./destroy.sh]
-- newer.yaml --
opstruss: "1.99"
name: a
later: true
tasks:
  up:
    run: [./up.sh]
  destroy:
    run: [./destroy.sh]
-- later.yaml --
opstruss: "1.99"
name: c
later: true
tasks:
  up:
    run: [./up.sh]
