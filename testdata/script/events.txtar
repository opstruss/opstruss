# Every run keeps record.json and events.jsonl in .opstruss/runs/<stack>/,
# and --json prints the same events, one per line.

env HOME=$WORK/home

exec opstruss up --yes --json
stdout '^\{"v":1,"seq":1,"time":"[^"]+","run":"[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}","type":"run","level":"info","message":"started","status":"running"\}$'
stdout '^\{"v":1,"seq":2,"time":"[^"]+","run":"[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}","type":"plan","level":"info","address":"default/web","task":"plan","message":"will run: new","status":"finished","outcome":"success","plan":\{"changes":\[\{"action":"run"\}\],"digest":"sha256:v1:[0-9a-f]+","exact":true,"outputs":\[\],"reason":"new","summary":"will run: new"\}\}$'
stdout '"type":"log","level":"info","address":"default/web","task":"up","stream":"stdout","message":"hello"'
stdout '"type":"run","level":"info","message":"success","status":"finished","outcome":"success","exit_code":0\}$'
exec sh -c 'cat .opstruss/runs/default/*/record.json'
stdout '"status": "finished"'
stdout '"command": "up"'
stdout '"outcome": "success"'
stdout '"approval": "--yes"'
exec sh -c 'cat .opstruss/runs/default/*/events.jsonl'
stdout '"message":"hello"'

# a task records its outputs in the last event and in record.json
exec opstruss greet --json
stdout '"type":"run",.*"outputs":\{"msg":"hi"\}'
exec sh -c 'grep -l greet .opstruss/runs/default/*/record.json | xargs cat'
stdout '"task": "greet"'
stdout '"msg": "hi"'

# a stream that an output reads goes to the log once it is parsed, and not
# at all when that output is sensitive
cd parse
exec opstruss up --yes
stdout '^default/meta \| \{"name":"shop"\}$'
exec opstruss read
stdout '^read: info \| \{"name":"shop"\}$'
stdout '^read: info \| loaded$'
! stdout 'key-from-stdout'
exec sh -c 'cat .opstruss/runs/default/*/events.jsonl'
stdout -count=2 'name.*shop'
! stdout 'key-from-stdout'

-- opstruss.yaml --
name: shop
units:
  web:
    run: echo hello
tasks:
  greet:
    run: echo "msg=hi" >> "$OPSTRUSS_OUTPUT"
    outputs:
      msg: {}
-- parse/opstruss.yaml --
name: parse
units:
  meta:
    run: echo '{"name":"shop"}'
    outputs:
      all: {type: object, from: stdout, format: json}
tasks:
  read:
    steps:
      - id: info
        run: echo '{"name":"shop"}'; echo loaded >&2
        outputs:
          info: {type: object, from: stdout, format: json}
      - id: key
        run: echo key-from-stdout
        outputs:
          key: {from: stdout, sensitive: true}
