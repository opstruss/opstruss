# logs shows the output of the units: the log of a service, the logs task
# of a plugin, or the output of the last run that touched a unit; -f goes
# on with the log of a service until Ctrl-C, and a plugin that follows
# gets the input follow.

env HOME=$WORK/home

# a run unit shows the output of the last run that touched it
exec opstruss up --yes site
exec opstruss up --yes --force site
exec opstruss logs site
stdout '^default/site: output of up in run [0-9]{8}T[0-9]{6}Z-[0-9a-f]{8} at '
stdout '^default/site \| built 2$'
! stdout 'built 1'
exec opstruss up --yes site
exec opstruss logs site
stdout '^default/site \| built 2$'
exec opstruss logs other
stdout '^default/other: no run touched it yet$'
exec opstruss show
stdout '^default/site \| built 2$'

# a plugin's logs task gets follow
exec opstruss up --yes api
exec opstruss logs api
stdout 'default/api \| follow=false'
exec opstruss logs -f api
stdout 'default/api \| follow=true'
exec opstruss logs --follow api
stdout 'default/api \| follow=true'

# a service shows its log, and -f goes on with it
exec opstruss up -d --yes web
waitgrep '"message":"tick 2"' .opstruss/logs/default/web.jsonl
exec opstruss logs web
stdout '^default/web \| tick 1$'
exec opstruss logs -f web &follow&
# Ctrl-C reaches it once its run started
waitgrep '(?s)"command": "logs",.*"status": "running"' '.opstruss/runs/default/*/record.json'
waitgrep '"message":"tick 12"' .opstruss/logs/default/web.jsonl
kill -INT follow
wait follow
stdout '^default/web \| tick 9$'
exec opstruss stop

# -f is for logs only
! exec opstruss status -f
stderr '-f is for logs and runs <run>, which follow what is written, not for status'

# a task shows the output of its last run: all of it as the task of the
# run, only its own inside the run of another; a name of a unit and a task
# shows both, and one of neither fails
cd tasks
exec opstruss build
exec opstruss logs build
stdout '^build: run [0-9]{8}T[0-9]{6}Z-[0-9a-f]{8} at \S+$'
stdout '^build \| building$'
exec opstruss release
exec opstruss logs build
stdout '^build: run \S+ at \S+ via release$'
stdout '^build \| building$'
! stdout 'before'
exec opstruss logs release
stdout '^release: before \| before$'
stdout '^build \| building$'
exec opstruss up --yes report
exec opstruss report
exec opstruss logs report
stdout '^default/report: output of up in run '
stdout '^default/report \| unit report$'
stdout '^report: run '
stdout '^report \| task report$'
exec opstruss logs never
stdout '^never: no run of it yet$'
! exec opstruss logs nothing
stderr 'no unit or task matches nothing'

# -f follows the run of a task that runs, then each later one, here of
# every in the daemon, until Ctrl-C, which ends logs with 0
exec opstruss up -d --yes
exec sh -c 'opstruss logs -f tick > tick.out 2>&1 & echo $! > pid; wait $!; echo $? > code' &follow&
waitgrep '(?s)^tick: run .*^tick \| tick.*^tick: run .*^tick \| tick' tick.out
exec sh -c 'kill -INT $(cat pid)'
wait follow
grep '^0$' code
exec opstruss stop

-- count --
0
-- opstruss.yaml --
name: shop
uses:
  tail: ./plugins/tail
units:
  site:
    run: |
      n=$(($(cat count) + 1))
      echo $n > count
      echo "built $n"
    approval: auto
  other:
    run: echo other
  api:
    uses: tail
    approval: auto
  web:
    service: |
      i=0
      while :; do
        i=$((i+1))
        echo "tick $i"
        sleep 0.1
      done
    approval: auto
tasks:
  show:
    steps:
      - task: logs
        units: [site]
-- plugins/tail/opstruss.plugin.yaml --
name: tail
tasks:
  up:
    run: [sh, -c, 'echo up']
  logs:
    inputs:
      follow: {type: boolean, default: false}
    run: [sh, -c, 'echo "follow=$INPUT_FOLLOW"']
-- tasks/opstruss.yaml --
name: ops
units:
  report:
    run: echo unit report
tasks:
  report:
    run: echo task report
  build:
    run: echo building
  never:
    run: echo never
  release:
    steps:
      - id: before
        run: echo before
      - task: build
  tick:
    on:
      every: 1s
    run: echo tick
