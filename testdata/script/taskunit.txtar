# A unit that uses a task runs it at up with its with: as inputs: a task
# of the project, of a plugin, or a built-in task. Its outputs become the
# unit's, its programs are the unit's, and destroy: of the unit takes it away.

env HOME=$WORK/home
chmod 755 build.sh
chmod 755 plugins/stamp/stamp.sh
chmod 755 scripts/run.sh

exec opstruss up
stdout '^default/image \| building v1 for default/image key default/image\.[0-9a-f]+ reason changed workdir yes$'
stdout '^default/site \| image app:v1 stamp stamped s1 config written$'
grep '^port: 80$' config.yaml
exec opstruss plan
stdout '^default/image: unchanged$'
stdout '^default/config: unchanged$'

# the task and the programs it names are its definition
exec sh -c 'echo "# changed" >> build.sh'
exec opstruss plan
stdout '^default/image: will run: definition changed: source$'
exec sh -c 'sed s/v1/v2/ opstruss.yaml > o.yaml && mv o.yaml opstruss.yaml'
exec opstruss plan
stdout '^default/image: will run: definition changed: source, with.tag$'
exec opstruss up
stdout 'building v2'

# so are the plugins that it calls and what uses: declares for them
exec sh -c 'echo "# changed" >> plugins/stamp/stamp.sh'
exec opstruss plan
stdout '^default/mark: will run: definition changed: source$'
stdout '^default/stamped: will run: definition changed: source$'
stdout '^default/retagged: will run: definition changed: source$'
exec opstruss up
exec sh -c 'sed "s/id: t1/id: t2/" opstruss.yaml > o.yaml && mv o.yaml opstruss.yaml'
exec opstruss plan
stdout '^default/retagged: will run: definition changed: source$'
stdout '^default/stamped: unchanged$'
exec opstruss up
stdout '^default/retagged: up: done$'

# a relative program is read from the dir: of its task or step
exec sh -c 'echo "# changed" >> scripts/run.sh'
exec opstruss plan
stdout '^default/scripted: will run: definition changed: source$'
stdout '^default/stepdir: will run: definition changed: source$'
exec opstruss up
stdout 'ran in scripts'

# destroy: of a unit that uses a task takes it away; one without is forgotten
exec opstruss destroy
stdout 'removed image'
exec opstruss state list
! stdout default

-- opstruss.yaml --
name: app
uses:
  stamp: ./plugins/stamp
  tagged:
    source: ./plugins/stamp
    with: {id: t1}
tasks:
  stampit:
    stamp.make: {id: s2}
  retag:
    tagged.make: {}
  in-dir:
    dir: scripts
    run: [./run.sh]
  step-in-dir:
    steps:
      - dir: scripts
        block:
          - run: [./run.sh]
  build:
    inputs:
      tag: {type: string, required: true}
    steps:
      - id: b
        run: [./build.sh, "${{ inputs.tag }}", "${{ opstruss.state_key }}", "${{ opstruss.reason }}"]
    outputs:
      image: {value: "app:${{ inputs.tag }}"}
units:
  image:
    uses: build
    with: {tag: v1}
    destroy: [sh, -c, 'echo removed image']
    approval: auto
  mark:
    uses: stamp.make
    with: {id: s1}
    approval: auto
  config:
    uses: write
    with: {path: config.yaml, content: {port: 80}, format: yaml}
    approval: auto
  site:
    uses: command
    with:
      argv: [echo, "image ${{ units.image.outputs.image }} stamp ${{ units.mark.outputs.text }} config ${{ units.config.outputs.path != '' ? 'written' : 'none' }}"]
    approval: auto
  stamped:
    uses: stampit
    approval: auto
  retagged:
    uses: retag
    approval: auto
  scripted:
    uses: in-dir
    approval: auto
  stepdir:
    uses: step-in-dir
    approval: auto
-- scripts/run.sh --
#!/bin/sh
echo "ran in ${PWD##*/}"
-- build.sh --
#!/bin/sh
wd=no
test -d "$OPSTRUSS_WORKDIR" && wd=yes
echo "building $1 for $OPSTRUSS_ADDRESS key $2 reason $3 workdir $wd"
-- plugins/stamp/opstruss.plugin.yaml --
name: stamp
tasks:
  make:
    inputs:
      id: {type: string, required: true}
    run: [./stamp.sh]
    outputs:
      text: {from: stdout}
-- plugins/stamp/stamp.sh --
#!/bin/sh
echo "stamped $INPUT_ID"
