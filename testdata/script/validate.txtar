# validate reads every stack and reports each problem with its place.

exec opstruss validate
stdout '^valid$'

# from a subdirectory, and from anywhere with -C
cd site
exec opstruss validate
stdout '^valid$'
cd $WORK/..
exec opstruss -C $WORK validate
stdout '^valid$'
cd $WORK

# problems name the file, line, column, and path, in every file at once
cp broken.yaml opstruss.yaml
! exec opstruss validate
stderr '^opstruss.yaml:5:5: units.site.comand: unknown key$'
stderr '^broken/release.yaml:3:5: tasks.release.when: when is an Ansible keyword; OpsTruss writes if$'
! stdout .

# rules beyond the schema come once the files have the right shape
cp twokinds.yaml opstruss.yaml
! exec opstruss validate
stderr '^opstruss.yaml:3:3: units.site: a unit has exactly one of run, service, or uses$'

# a reference to what does not exist is a problem too
cp missingref.yaml opstruss.yaml
! exec opstruss validate
stderr '^opstruss.yaml:4:5: units.site.run: there is no unit db \(in \$\{\{ units.db.outputs.url \}\}\)$'

# --json prints one document
! exec opstruss validate --json
stdout '"valid": false'
stdout '"path": "units.site.run"'

# dir and retry.until of a unit are checked like its other keys, and the
# units they read come first
cp unitkeys.yaml opstruss.yaml
exec opstruss explain
stdout '^order:\n  - zone\n  - app\n  - web$'
cp badkeys.yaml opstruss.yaml
! exec opstruss validate
stderr '^opstruss.yaml:5:5: units.app.dir: there is no unit nope \(in \$\{\{ units.nope.outputs.dir \}\}\)$'
stderr '^opstruss.yaml:8:7: units.app.retry.until: retry.until of a unit cannot read tasks '

# no input makes a flag of OpsTruss, or a flag that another input makes
cp flags.yaml opstruss.yaml
! exec opstruss validate
stderr '^opstruss.yaml:6:7: tasks.build.inputs.event: input event makes the flag --event, which is a flag of OpsTruss; rename the input$'
stderr '^opstruss.yaml:7:7: tasks.build.inputs.no_cache: input no_cache makes the flag --no-cache, which is the flag of input cache; rename the input$'
stderr '^opstruss.yaml:8:7: tasks.build.inputs.yes: input yes makes the flag --yes, which is a flag of OpsTruss; rename the input$'

# paths are read as written, so a shell variable in them is a problem
cp shellpath.yaml opstruss.yaml
! exec opstruss validate
stderr '^opstruss.yaml:5:17: units.site.generates\[0\]: \$OPSTRUSS_ARTIFACTS/hello.txt: paths are read as written, relative to the file of the unit, so \$OPSTRUSS_ARTIFACTS is not expanded; write the result to a path of the project, such as dist/hello.txt$'

-- opstruss.yaml --
name: app
include: [tasks/*.yaml]
stacks:
  dev: {}
  prod:
    include: [prod/*.yaml]
units:
  site:
    run: [npm, run, build]
-- broken.yaml --
name: app
include: [broken/*.yaml]
units:
  site:
    comand: [npm, run, build]
-- twokinds.yaml --
name: app
units:
  site:
    run: [npm, run, build]
    service: [npm, start]
-- shellpath.yaml --
name: app
units:
  site:
    run: [npm, run, build]
    generates: [$OPSTRUSS_ARTIFACTS/hello.txt]
-- missingref.yaml --
name: app
units:
  site:
    run: [deploy, "${{ units.db.outputs.url }}"]
-- unitkeys.yaml --
name: app
units:
  app:
    run: ["true"]
    dir: ${{ units.zone.outputs.dir }}
  web:
    run: [./check.sh]
    outputs:
      ready: {from: stdout}
    retry:
      attempts: 2
      until: ${{ outputs.ready == 'yes' && units.zone.outputs.dir != '' }}
  zone:
    run: [pwd]
    outputs:
      dir: {from: stdout}
-- badkeys.yaml --
name: app
units:
  app:
    run: ["true"]
    dir: ${{ units.nope.outputs.dir }}
    retry:
      attempts: 2
      until: ${{ tasks.x.outcome == 'success' }}
-- flags.yaml --
name: app
tasks:
  build:
    inputs:
      cache: {type: boolean}
      event: {type: string}
      no_cache: {type: boolean}
      yes: {type: string}
    run: [make]
-- tasks/release.yaml --
tasks:
  release:
    run: [./release.sh]
-- broken/release.yaml --
tasks:
  release:
    when: inputs.ok
    run: [./release.sh]
-- prod/backup.yaml --
units:
  backup:
    run: [./backup.sh]
-- site/index.html --
<p>site</p>
