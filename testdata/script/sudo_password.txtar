# sudo that wants a password fails a run without a terminal before the
# program starts, with the rule of sudoers that needs none and what sudo
# said; a ticket that sudo -v made for this run lets it run. doctor says which, with the rule of
# sudoers that needs no password. sudoers log_input, which takes the
# socket of __sudo away, is refused with the line that turns it off.

env HOME=$WORK/home
mkdir home/.fakesudo
cp pw home/.fakesudo/password

! exec opstruss install
stderr 'sudo needs a password, and this run has no terminal to ask for it; to run without one, add \S+ ALL=\(root\) NOPASSWD: \S+/opstruss __sudo to sudoers, which lets any program run as root \(sudo: a password is required\)'
! stdout 'installed'
grep -count=1 '^-n -- \S+/opstruss __sudo$' home/.fakesudo/log
! grep 'secret-pw' home/.fakesudo/log

exec opstruss doctor
stdout '^warn +sudo needs a password to run \S+/opstruss __sudo \(sudo: a password is required\), or this user may not use sudo: a run at a terminal asks for the password, and a run without one fails; to run without a password, add \S+ ALL=\(root\) NOPASSWD: \S+/opstruss __sudo to sudoers'

exec touch home/.fakesudo/ticket
exec opstruss install
stdout 'installed as root'
exec opstruss doctor
stdout '^ok +sudo runs \S+/opstruss __sudo without a password$'

exec touch home/.fakesudo/log_input
! exec opstruss install
stderr 'its stdin is not the socket of opstruss, as sudoers log_input makes it; add Defaults!\S+/opstruss !log_input to sudoers'
! stdout 'installed'

-- pw --
secret-pw
-- opstruss.yaml --
name: password
tasks:
  install:
    run: 'echo "installed as $USER"'
    sudo: true
