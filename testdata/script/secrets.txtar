# Secrets come from sops files, the environment, a program, or a task of a
# plugin. Each is resolved only when an expression of what runs reads it,
# once a run, and hidden wherever the run writes; a source that fails fails
# only what reads it, with its name. What the run writes out also hides the
# shapes of well-known credentials, and what pass: lets through by a name
# that says it is a secret, while the data that holds them stays as it is.

# The age key of this machine is the one sops reads, which also opens the
# data key of the stack, and the project's rule for its secrets names it.
env HOME=$WORK/home
env SOPS_AGE_KEY_FILE=$WORK/age/keys.txt
env CI_TOKEN=ci-token-value-1
env SESSION=sess-value-1
agekey age/keys.txt AGE_RECIPIENT
exec sh -c 'printf "creation_rules:\n  - path_regex: ^secrets/\n    age: %s\n" "$AGE_RECIPIENT" > .sops.yaml'
mkdir secrets
exec sops encrypt --filename-override secrets/db.sops.yaml --output secrets/db.sops.yaml plain.yaml
! exec grep pg-pass secrets/db.sops.yaml
exec opstruss validate

# what runs reads its secrets and nothing else: web does not read broken,
# and svc, whose component reads marker through its input, does not run
exec opstruss up web --yes
stdout '^default/web \| db postgres://app:\*\*\*@db/app$'
stdout '^default/web \| ci \*\*\* api \*\*\* vault \*\*\*$'
stdout '^default/web \| restic \*\*\* whole \*\*\*$'
! stdout 'pg-pass|ci-token|sess-value|vault-kv|restic-b2'
! stderr 'pg-pass|ci-token|sess-value|vault-kv|restic-b2'
! exec grep -r -e pg-pass -e ci-token -e sess-value -e vault-kv -e restic-b2 .opstruss
! exists marker-ran

# one run resolves a secret once, for every unit that reads it
exec opstruss up twice again --yes
stdout '^default/twice \| counted \*\*\*$'
stdout '^default/again \| again \*\*\*$'
exec sh -c 'wc -l < resolved.log'
stdout '^ *1$'

# a source that fails fails the units that read it, with its name, and
# the others run
! exec opstruss up fails nofield svc --yes
stdout 'secret broken: NOT_SET_ANYWHERE is not set'
stdout 'secret nofield: secrets/db.sops.yaml has no postgres.nope'
stderr '^default/fails: cannot be planned$'
stdout '^default/svc/inner \| inner \*\*\*$'
exists marker-ran
! stdout never

# the digest holds a secret by its HMAC: a new value runs the unit again
env CI_TOKEN=ci-token-value-2
exec opstruss plan web
stdout '^default/web: will run'
! stdout ci-token

# opstruss exec gives the program the unit's secrets
exec opstruss exec web -- sh -c 'test "$CI" = ci-token-value-2 && echo matched'
stdout '^matched$'

# a task reads them too
exec opstruss show
stdout '^show \| token \*\*\*$'

# commands that only read never resolve one: an output that reads a
# secret shows as *** without it, and is shown only in a run
exec opstruss explain
! stdout 'pg-pass|ci-token'
exec opstruss outputs
stdout '^token_size: \*\*\*$'
! exec opstruss outputs --show-sensitive
stderr 'secret marker: secrets are read only in a run'

# a stack overrides a secret by name
env PROD_TOKEN=prod-token-value
exec opstruss -C overlay check --stack prod
stdout '^check \| from prod$'
exec opstruss -C overlay check --stack dev
stdout '^check \| from dev$'

# a run hides the shape of a credential that no one told it of, and a
# value that pass: lets through by such a name, in what it writes out:
# the terminal, --json, events.jsonl, and runs; a short one is warned of
env GITHUB_TOKEN=from-the-ci-value-1
env SHORT_TOKEN=abc
env APP_NAME=visible-name-1
env DEPLOY_TOKEN=deploy-value-1
exec opstruss -C shapes leak
stdout -count=6 '^leak(: \w+)? \| shape \*\*\* end$'
stdout '^leak(: \w+)? \| github \*\*\* short abc name visible-name-1$'
stdout -count=3 '^leak(: \w+)? \| \*\*\*$'
stdout '^leak(: \w+)? \| after the key$'
stdout '^leak(: \w+)? \| near ghp_short and gh[p]_xyz$'
stdout '^  token: \*\*\*$'
stderr 'variable SHORT_TOKEN is shorter than 4 characters, so the output does not hide it'
! stderr 'holds a sensitive value'
! stdout 'aB3dE5gH7jK9|from-the-ci|MIIEowIB'
exec opstruss -C shapes leak --json
stdout '"message":"shape \*\*\* end"'
! stdout 'aB3dE5gH7jK9|from-the-ci|MIIEowIB'
exec sh -c 'cd shapes && for r in $(opstruss runs | cut -d" " -f1); do opstruss runs "$r"; done'
stdout 'shape \*\*\* end'
! stdout 'aB3dE5gH7jK9|from-the-ci|MIIEowIB'
! exec grep -r -l --include=events.jsonl -e aB3dE5gH7jK9 -e from-the-ci -e MIIEowIB shapes/.opstruss
# the data keeps the shape: the next step gets it, and so does the state,
# which needs no key for it
exec grep -c '^gh[p]_aB3dE5gH7jK9' shapes/used.txt
stdout '^1$'
exec opstruss -C shapes up app --yes
stdout '^default/app \| unit \*\*\*$'
! stderr 'holds a sensitive value'
exec opstruss -C shapes state pull app
stdout '"token": "gh[p]_aB3dE5gH7jK9'
! stdout 'enc:v1'
exec opstruss -C shapes destroy app --yes
stdout '^default/app \| destroy \*\*\*$'
! stdout deploy-value

-- shapes/opstruss.yaml --
name: shapes
units:
  app:
    run: |
      echo "unit $DEPLOY_TOKEN"
      printf 'token=%s%s\n' "$(printf gh.p_ | tr -d .)" aB3dE5gH7jK9mN1pQ2sT4vW6yZ8cF0aB3dE5 >> "$OPSTRUSS_OUTPUT"
    destroy: echo "destroy $DEPLOY_TOKEN"
    pass: [DEPLOY_TOKEN]
    outputs:
      token: {type: string}
tasks:
  leak:
    pass: ['GITHUB_*', SHORT_TOKEN, APP_NAME]
    steps:
      - id: make
        run: |
          b=aB3dE5gH7jK9mN1pQ2sT4vW6yZ8cF0aB3dE5gH7jK9mN1pQ2sT4vW6yZ8cF0aB3dE5gH7jK9mN1pQ2sT4vW6yZ8cF0aB3dE5
          for p in gh.p_ git.hub_pat_ gl.pat- xo.xb- sk._live_ sk.-ant-; do
            echo "shape $(printf '%s' "$p" | tr -d .)$b end"
          done
          printf 'token=%s%s\n' "$(printf gh.p_ | tr -d .)" aB3dE5gH7jK9mN1pQ2sT4vW6yZ8cF0aB3dE5 >> "$OPSTRUSS_OUTPUT"
        outputs: {token: {}}
      - id: use
        run: printf '%s\n' "$T" > used.txt
        env: {T: '${{ steps.make.outputs.token }}'}
      - id: say
        run: |
          echo "github $GITHUB_TOKEN short $SHORT_TOKEN name $APP_NAME"
          printf '%s\n' "-----BEGIN RSA PRIVATE KEY-----" "MIIEowIBAAKCAQEA" "-----END RSA PRIVATE KEY-----" "after the key"
          echo "near ghp_short and $(printf gh.p_ | tr -d .)xyz"
    outputs:
      token:
        value: ${{ steps.make.outputs.token }}
-- plain.yaml --
postgres:
  password: pg-pass-123
restic:
  b2: restic-b2-key
  s3: restic-s3-key
-- opstruss.yaml --
name: app
inputs:
  to: {type: string, default: b2}
uses:
  vaultish: ./plugins/vaultish
secrets:
  db:
    sops: secrets/db.sops.yaml
    field: postgres.password
  backup:
    sops: secrets/db.sops.yaml
  nofield:
    sops: secrets/db.sops.yaml
    field: postgres.nope
  ci:
    env: CI_TOKEN
  api:
    run: test -z "${OPSTRUSS_ARTIFACTS:-}" && printf 'api-%s-%s\n' "$STACK" "$SESSION"
    env: {STACK: '${{ stack }}'}
    pass: [SESSION]
  vault:
    vaultish.read:
      path: kv/app
  counted:
    run: echo resolved >> resolved.log && echo counted-value-42
  marker:
    run: touch marker-ran && echo marker-value
  broken:
    env: NOT_SET_ANYWHERE
locals:
  url: postgres://app:${{ secrets.db }}@db/app
outputs:
  token_size: ${{ units.svc.outputs.size }}
units:
  web:
    run: |
      echo "db $URL"
      echo "ci $CI api $API vault $VAULT"
      echo "restic $RESTIC whole $WHOLE"
    env:
      URL: ${{ locals.url }}
      CI: ${{ secrets.ci }}
      API: ${{ secrets.api }}
      VAULT: ${{ secrets.vault }}
      RESTIC: ${{ secrets.backup.restic[inputs.to] }}
      WHOLE: ${{ secrets.backup.postgres.password }}
  twice:
    run: echo "counted $C"
    env: {C: '${{ secrets.counted }}'}
  again:
    run: echo "again $C"
    env: {C: '${{ secrets.counted }}'}
  fails:
    run: echo never
    env: {B: '${{ secrets.broken }}'}
  nofield:
    run: echo never
    env: {B: '${{ secrets.nofield }}'}
  svc:
    uses: ./comp
    with: {token: '${{ secrets.marker }}'}
tasks:
  show:
    run: echo "token $T"
    env: {T: '${{ secrets.ci }}'}
-- comp/opstruss.yaml --
inputs:
  token: {type: string}
  enabled: {type: boolean, default: true}
outputs:
  size: ${{ size(inputs.token) }}
units:
  inner:
    if: ${{ inputs.enabled }}
    run: echo "inner $T"
    env: {T: '${{ inputs.token }}'}
-- plugins/vaultish/opstruss.plugin.yaml --
name: vaultish
description: Reads a secret at a path, as Vault would
tasks:
  read:
    inputs:
      path: {type: string, required: true}
    outputs:
      value: {type: string}
    run: test -z "${OPSTRUSS_ARTIFACTS:-}" && echo "value=vault-$INPUT_PATH-secret" > "$OPSTRUSS_OUTPUT"
-- overlay/opstruss.yaml --
name: overlay
stacks:
  dev: {}
  prod:
    secrets:
      ci: {env: PROD_TOKEN}
secrets:
  ci: {env: CI_TOKEN}
tasks:
  check:
    run: |
      case "$T" in
        prod-token-value) echo "from prod" ;;
        ci-token-value-*) echo "from dev" ;;
      esac
    env: {T: '${{ secrets.ci }}'}
