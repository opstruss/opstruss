# OpsTruss killed at each point of an up leaves a record that the next up
# finishes, and a program it left running is waited for; events that a
# full disk refuses only mark the record of the run. Run with
# go test -tags failpoints.

[!failpoints] skip 'needs a build with -tags failpoints'
env HOME=$WORK/home

# killed before the pending mark, the unit is still new
env OPSTRUSS_FAILPOINT=up-before-pending=kill
! exec opstruss up db --yes
env OPSTRUSS_FAILPOINT=
exec opstruss plan db
stdout '^default/db: will run: new$'
stderr 'ended without finishing its record; it is marked cancelled, as interrupted$'

# killed after it, or after the program, or before the last write, the
# next plan shows the attempt that did not finish, and up finishes it
env OPSTRUSS_FAILPOINT=up-before-program=kill
! exec opstruss up db --yes
env OPSTRUSS_FAILPOINT=
exec opstruss plan db
stdout '^default/db: will run: up of run .* did not finish$'
env OPSTRUSS_FAILPOINT=up-before-put=kill
! exec opstruss up db --yes
env OPSTRUSS_FAILPOINT=
exec opstruss up db --yes
stdout '^default/db: up: done$'
exec opstruss state pull db
! stdout '"pending"'
stdout '"id": "made-'

# a program that outlives its OpsTruss is waited for before the next
# attempt, also as sh and sleep, whose environment macOS hides
env OPSTRUSS_FAILPOINT=program-started=kill
! exec opstruss up slow --yes
env OPSTRUSS_FAILPOINT=
exec opstruss up slow --yes
stdout '^default/slow: waiting for .* of interrupted run '
stdout '^default/slow: up: done$'
cmp slow.log slow.want
# the temporary files of the killed run go once none of its programs is left
exec opstruss plan
exec sh -c 'ls .opstruss/tmp | wc -l'
stdout '^ *0$'

# a move killed at any stage is finished by the next up with that entry
cp moved.yaml opstruss.yaml
env OPSTRUSS_FAILPOINT=moved-after-pending=kill
! exec opstruss up db --yes
env OPSTRUSS_FAILPOINT=
exec opstruss plan store
stdout '^default/store: will move from default/db$'
stdout '^default/store: unchanged$'
env OPSTRUSS_FAILPOINT=moved-after-copy=kill
! exec opstruss up store --yes
env OPSTRUSS_FAILPOINT=moved-after-tombstone=kill
! exec opstruss up store --yes
env OPSTRUSS_FAILPOINT=
exec opstruss plan store
stdout '^default/store: will finish the move from default/db$'
stdout '^default/store: unchanged$'
exec opstruss up store --yes
stdout '^default/store: unchanged$'
exec opstruss state pull store
! stdout '"pending"'
stdout '"id": "made-'

# events that cannot be written leave what the run does as it is; the run
# says so, exits as it would, and its record says that events are missing
env OPSTRUSS_FAILPOINT=record-events-write=fail
exec opstruss up store --yes
stdout '^default/store: unchanged$'
stderr '^not every event of the run was stored: failpoint record-events-write$'
env OPSTRUSS_FAILPOINT=
exec sh -c 'grep -l "\"events_incomplete\": true" .opstruss/runs/default/*/record.json'

# a run nested in one that holds the record of an instance of a component
# for a moment waits for it to move that record, rather than failing
cd nested
exec opstruss up --yes
cp two.yaml site/opstruss.yaml
env OPSTRUSS_FAILPOINT=up-before-pending=pause
env OPSTRUSS_FAILPOINT_PAUSE=$WORK/paused
exec sh -c 'opstruss up site/new --yes > parent.out 2>&1; echo $? > parent.code' &
waitfile $WORK/paused
env OPSTRUSS_FAILPOINT=
cp renamed.yaml opstruss.yaml
exec sh -c 'run=$(grep -l running .opstruss/runs/default/*/record.json); run=${run%/record.json}; OPSTRUSS_RUN=${run##*/} opstruss up place/web --yes > nested.out 2>&1; echo $? > nested.code' &
waitgrep 'waiting for the lock held by run|which this run is nested in' nested.out
rm $WORK/paused
wait
grep '^default/site: waiting for the lock held by run ' nested.out
grep '^0$' nested.code
grep '^default/place: moved from default/site$' nested.out
grep '^0$' parent.code

# a destroy that waits for the lock of a unit while another run makes a unit
# that needs it leaves the unit as it was, and names the one that needs it
cd $WORK/needs
exec opstruss up --yes base
env OPSTRUSS_FAILPOINT=up-before-program=pause
env OPSTRUSS_FAILPOINT_PAUSE=$WORK/held
exec sh -c 'opstruss up --yes --force base > held1.out 2>&1; echo $? > held1.code' &
waitfile $WORK/held
env OPSTRUSS_FAILPOINT=
exec sh -c 'opstruss destroy --yes > destroy1.out 2>&1; echo $? > destroy1.code' &
waitgrep '^default/base: waiting for the lock held by run ' destroy1.out
exec opstruss up --yes --no-deps app
stdout '^default/app: up: done$'
rm $WORK/held
wait
grep '^0$' held1.code
grep '^1$' destroy1.code
grep '^default/base: default/app came to need it after the plan, so it stays$' destroy1.out
exec opstruss state pull base
! stdout '"pending"'
! exists destroys

# destroy --no-deps leaves such a unit as it is
exec opstruss destroy --yes app
env OPSTRUSS_FAILPOINT=up-before-program=pause
exec sh -c 'opstruss up --yes --force base > held2.out 2>&1; echo $? > held2.code' &
waitfile $WORK/held
env OPSTRUSS_FAILPOINT=
exec sh -c 'opstruss destroy --yes --no-deps base > destroy2.out 2>&1; echo $? > destroy2.code' &
waitgrep '^default/base: waiting for the lock held by run ' destroy2.out
exec opstruss up --yes --no-deps app
rm $WORK/held
wait
grep '^0$' destroy2.code
grep '^base$' destroys
exists .opstruss/state/default/app/state.json

# a unit whose upstream unit another run is destroying does not start, and
# a unit that had no record has none again
exec opstruss destroy --yes app
exec opstruss up --yes base
env OPSTRUSS_FAILPOINT=destroy-before-program=pause
env OPSTRUSS_FAILPOINT_PAUSE=$WORK/marked
exec sh -c 'opstruss destroy --yes > destroy3.out 2>&1; echo $? > destroy3.code' &
waitfile $WORK/marked
env OPSTRUSS_FAILPOINT=
! exec opstruss up --yes --no-deps app
stderr '^default/app: default/base, which it needs, has an unfinished destroy of run [^ ]+; up again once that run ends$'
! exists .opstruss/state/default/app/state.json
rm $WORK/marked
wait
grep '^0$' destroy3.code
! exists .opstruss/state/default/base/state.json

-- needs/opstruss.yaml --
name: needs
units:
  base:
    run: echo "id=b-$$" >> "$OPSTRUSS_OUTPUT"
    destroy: echo base >> destroys
    outputs:
      id: {}
  app:
    run: echo "app on $BASE"
    env:
      BASE: ${{ units.base.outputs.id }}
    destroy: echo app >> destroys

-- nested/opstruss.yaml --
name: nested
units:
  site:
    uses: ./site
-- nested/site/opstruss.yaml --
units:
  web:
    run: echo web
-- nested/two.yaml --
units:
  web:
    run: echo web
  new:
    run: echo new
-- nested/renamed.yaml --
name: nested
units:
  place:
    uses: ./site
moved:
  - {from: site, to: place}
-- moved.yaml --
name: shop
units:
  store:
    run: echo "id=made-$$" >> "$OPSTRUSS_OUTPUT"
    outputs:
      id: {}
moved:
  - {from: db, to: store}
-- opstruss.yaml --
name: shop
units:
  db:
    run: echo "id=made-$$" >> "$OPSTRUSS_OUTPUT"
    outputs:
      id: {}
  slow:
    run: echo "start $OPSTRUSS_REASON" >> slow.log; sleep 1; echo "end $OPSTRUSS_REASON" >> slow.log
-- slow.want --
start changed
end changed
start interrupted
end interrupted
