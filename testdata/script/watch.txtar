# A watch makes runs of the lines of a service, the changes of files, or
# the lines of a program it runs as a source; if: chooses each event and
# debounce gathers them. up -d returns once each watch is ready, so a file
# written at once makes an event. A task of a plugin as a source reads a
# secret and works in the directory of the task that watches. up keeps the
# sources whose definition stays, with what they gathered, and their runs
# take the task as it is now. after makes a run when another run ends, and
# a chain of after stops past three.

env HOME=$WORK/home
env FEED_TOKEN=feed-secret
exec chmod 755 feed/lines.sh

# 500 files come before inbox/ in its watch, so its first stat reaches
# inbox/ only after a while on macOS; a file written as soon as up -d
# returns still makes an event
exec sh -c 'mkdir -p bulk inbox up && cd bulk && seq 500 | xargs touch'
exec opstruss up -d --yes
cp note.md inbox/note.md
waitgrep '^inbox inbox/note.md$' fired
waitgrep '^line error: disk full$' fired
! grep 'all good' fired
waitgrep '^source one -$' fired
waitgrep '^source \{"n":2\} 2$' fired
waitgrep '^feed token of 11 characters$' fired
exists where
! exists feed/where

# a relative pattern that leaves the directory of its task through ..
# watches the files it names there, which event.paths shows absolute
cp note.md up/n.txt
waitgrep '^parent /.*/up/n.txt$' fired

# files that change make one run with debounce
mkdir src
exec sh -c 'echo a > src/a.txt; echo b > src/b.txt'
waitgrep '^paths 2 ' fired

# up keeps the sources that stay: the programs do not start again, and a
# file written just before an up is in the debounce that goes on
exec sh -c 'echo c > src/c.txt'
exec opstruss up --yes
exec opstruss up --yes
waitgrep '^paths 1 src/c.txt$' fired
grep -count=1 '^source one -$' fired
grep -count=1 '^feed token of 11 characters$' fired
grep 'installed 10 triggers: 0 sources started, 6 kept, 0 stopped, 0 failed' .opstruss/logs/default/_daemon.jsonl

# a changed task takes effect without starting its source again
exec sed -i.bak 's/echo "paths /echo "again /' opstruss.yaml
exec opstruss up --yes
exec sh -c 'echo d > src/d.txt'
waitgrep '^again 1 src/d.txt$' fired
grep -count=1 '^source one -$' fired

# a run that ends makes the runs of after, three deep at most
exec opstruss t1
waitgrep '^t4 after t3 success$' fired
grep '^t2 after t1 success$' fired
waitgrep 'after t4: run [0-9T]+Z-[0-9a-f]+ is 3 deep in a chain of after, so it makes no run' .opstruss/logs/default/_daemon.jsonl
! grep '^t5' fired
exec opstruss stop

-- note.md --
a note
-- opstruss.yaml --
name: shop
include: [sub/tasks.yaml]
inputs:
  src: {type: string, default: src}
uses:
  feed: ./feed
secrets:
  feed_token: {env: FEED_TOKEN}
units:
  web:
    service: |
      echo "all good"
      echo "error: disk full"
      exec sleep 300
    approval: auto
tasks:
  lines:
    run: echo "line $LINE" >> fired
    env: {LINE: '${{ event.line }}'}
    on:
      watch:
        unit: web
        if: event.line.contains('error')
  source:
    run: echo "source $LINE $N" >> fired
    env: {LINE: '${{ event.line }}', N: '${{ has(event.data) ? string(event.data.n) : "-" }}'}
    on:
      watch:
        command: {argv: [sh, -c, 'echo one; echo "{\"n\":2}"; exec sleep 300']}
  feed:
    run: echo "feed $LINE" >> fired
    env: {LINE: '${{ event.line }}'}
    on:
      watch:
        feed.lines:
          token: ${{ secrets.feed_token }}
  files:
    run: echo "paths $N $P" >> fired
    env: {N: '${{ string(event.count) }}', P: '${{ event.paths.map(p, p.path).join(",") }}'}
    on:
      watch:
        paths: ['${{ inputs.src }}/**']   # read as the daemon installs the trigger
        debounce: 2s
  inbox:
    run: echo "inbox $P" >> fired
    env: {P: '${{ event.paths.map(p, p.path).join(",") }}'}
    on:
      watch:
        paths: [bulk/**, inbox/*.md]
  t1:
    run: echo t1 >> fired
  t2:
    run: echo "t2 after $T $O" >> fired
    env: {T: '${{ event.task }}', O: '${{ event.outcome }}'}
    on: {after: {task: t1}}
  t3:
    run: echo "t3 after $T $O" >> fired
    env: {T: '${{ event.task }}', O: '${{ event.outcome }}'}
    on: {after: {task: t2}}
  t4:
    run: echo "t4 after $T $O" >> fired
    env: {T: '${{ event.task }}', O: '${{ event.outcome }}'}
    on: {after: {task: t3}}
  t5:
    run: echo "t5 after $T" >> fired
    env: {T: '${{ event.task }}'}
    on: {after: {task: t4}}
-- sub/tasks.yaml --
tasks:
  parent:
    run: echo "parent $P" >> ../fired
    env: {P: '${{ event.paths.map(p, p.path).join(",") }}'}
    on:
      watch:
        paths: [../up/*.txt]
-- feed/opstruss.plugin.yaml --
name: feed
tasks:
  lines:
    inputs:
      token: {type: string, required: true, sensitive: true}
    run: [./lines.sh]
-- feed/lines.sh --
#!/bin/sh
pwd > where
echo "token of ${#INPUT_TOKEN} characters"
exec sleep 300
