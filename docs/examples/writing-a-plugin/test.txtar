chmod 755 plugins/note/note.sh
exec opstruss plan
stdout '^default/readme: will run: new; plan: create notes/readme.txt$'
exec opstruss up --yes
stdout '^default/readme: up: done$'
grep '^hello$' notes/readme.txt
exec opstruss plan
stdout '^default/readme: unchanged$'
exec sh -c 'echo changed > notes/readme.txt'
exec opstruss plan
stdout '^default/readme: will run: plan: update notes/readme.txt$'
exec opstruss destroy --yes
stdout '^default/readme: destroy: done$'
! exists notes/readme.txt
