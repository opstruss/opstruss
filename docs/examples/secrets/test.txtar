[!exec:sops] skip 'needs sops'
env SOPS_AGE_KEY_FILE=$WORK/age/keys.txt
env DEPLOY_TOKEN=deploy-token-value
agekey age/keys.txt AGE_RECIPIENT
exec sh -c 'printf "creation_rules:\n  - path_regex: ^secrets/\n    age: %s\n" "$AGE_RECIPIENT" > .sops.yaml'
mkdir secrets
exec sops encrypt --filename-override secrets/default.env --output secrets/default.env plain.env
! grep zone-token-value secrets/default.env
exec opstruss up --yes
stdout '^default/dns \| zone token \*\*\*$'
stdout '^default/deploy \| deploy token \*\*\*$'
! stdout 'zone-token-value|deploy-token-value'
! exec grep -r -e zone-token-value -e deploy-token-value .opstruss
-- plain.env --
CLOUDFLARE_API_TOKEN=zone-token-value
HCLOUD_TOKEN=hcloud-token-value
