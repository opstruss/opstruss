{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpsTruss dependency lock",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "hash": {
            "type": "string",
            "pattern": "^h1:[A-Za-z0-9+/]{43}=$"
          }
        },
        "required": [
          "commit",
          "hash"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "sources"
  ],
  "additionalProperties": false
}
